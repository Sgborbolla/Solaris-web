---
import PublicLayout from '../layouts/PublicLayout.astro';
import { supabase } from '../lib/supabase.js';
const { data: settings } = await supabase.from('site_settings').select('*');
const settingsObj = {}; settings?.forEach(s => { settingsObj[s.key] = s.value; });
---
<PublicLayout title="Contacto" description="Ponte en contacto con nosotros" isHome={false}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-solaris-dark mb-4">Contáctanos</h1>
      <p class="text-xl text-solaris-text max-w-2xl mx-auto">Escríbenos y un especialista te contactará en menos de 24 horas.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <a href={`https://wa.me/${settingsObj.whatsapp_number || '1234567890'}`} target="_blank" class="card p-6 text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-green-100 flex items-center justify-center group-hover:bg-green-200 transition-colors">
          <svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </div>
        <h3 class="text-lg font-bold text-solaris-dark mb-2">WhatsApp</h3>
        <p class="text-solaris-text text-sm">Respuesta inmediata.</p>
      </a>
      <a href={`tel:${settingsObj.phone || '+521234567890'}`} class="card p-6 text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-blue-100 flex items-center justify-center group-hover:bg-blue-200 transition-colors">
          <svg class="w-8 h-8 text-solaris-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        </div>
        <h3 class="text-lg font-bold text-solaris-dark mb-2">Llámanos</h3>
        <p class="text-solaris-text text-sm">{settingsObj.phone || '+52 123 456 7890'}</p>
      </a>
      <a href={`mailto:${settingsObj.email || 'contacto@solaris.com'}`} class="card p-6 text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-amber-100 flex items-center justify-center group-hover:bg-amber-200 transition-colors">
          <svg class="w-8 h-8 text-solaris-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </div>
        <h3 class="text-lg font-bold text-solaris-dark mb-2">Correo</h3>
        <p class="text-solaris-text text-sm">{settingsObj.email || 'contacto@solaris.com'}</p>
      </a>
    </div>
    <div class="max-w-2xl mx-auto card p-8 md:p-10 mb-12">
      <h2 class="text-2xl font-bold text-solaris-dark mb-6 text-center">Envíanos un mensaje</h2>
      <form id="contact-form" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-semibold text-solaris-dark mb-2">Nombre completo</label>
            <input type="text" id="name" required class="w-full px-4 py-3 border border-solaris-border rounded-card focus:ring-2 focus:ring-solaris-primary outline-none bg-white" placeholder="Tu nombre" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-semibold text-solaris-dark mb-2">Teléfono</label>
            <input type="tel" id="phone" class="w-full px-4 py-3 border border-solaris-border rounded-card focus:ring-2 focus:ring-solaris-primary outline-none bg-white" placeholder="Tu número" />
          </div>
        </div>
        <div>
          <label for="email" class="block text-sm font-semibold text-solaris-dark mb-2">Correo electrónico</label>
          <input type="email" id="email" required class="w-full px-4 py-3 border border-solaris-border rounded-card focus:ring-2 focus:ring-solaris-primary outline-none bg-white" placeholder="tu@correo.com" />
        </div>
        <div>
          <label for="message" class="block text-sm font-semibold text-solaris-dark mb-2">¿En qué podemos ayudarte?</label>
          <textarea id="message" rows="5" required class="w-full px-4 py-3 border border-solaris-border rounded-card focus:ring-2 focus:ring-solaris-primary outline-none bg-white resize-none" placeholder="Cuéntanos sobre tu proyecto..."></textarea>
        </div>
        <button type="submit" class="w-full btn-primary justify-center py-4 text-lg font-semibold">Enviar Mensaje</button>
      </form>
    </div>
    <div class="card p-8 mb-8">
      <h2 class="text-2xl font-bold text-solaris-dark mb-4 text-center">Nuestra Ubicación</h2>
      {settingsObj.map_image ? (
        <div class="aspect-video rounded-card overflow-hidden mb-4 border-2 border-solaris-border">
          <img src={settingsObj.map_image} alt="Mapa" class="w-full h-full object-cover" />
        </div>
      ) : (
        <div class="aspect-video rounded-card overflow-hidden mb-4 border-2 border-dashed border-solaris-border bg-solaris-gray flex items-center justify-center">
          <div class="text-center p-8">
            <svg class="w-20 h-20 mx-auto mb-4 text-solaris-text" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <p class="text-solaris-text text-lg font-semibold mb-2">Mapa de Ubicación</p>
            <p class="text-solaris-text text-sm">Sube una captura desde el panel de administración</p>
          </div>
        </div>
      )}
      {settingsObj.map_description && <p class="text-solaris-text text-center leading-relaxed mb-4">{settingsObj.map_description}</p>}
      {settingsObj.address && <div class="flex items-center justify-center gap-2 text-solaris-dark font-semibold text-lg"><svg class="w-5 h-5 text-solaris-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg><span>{settingsObj.address}</span></div>}
    </div>
  </div>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline>
    const sb = window.supabase.createClient('https://djyysffxpbvbfkcmrhta.supabase.co','eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRqeXlzZmZ4cGJ2YmZrY21yaHRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMjc5MTYsImV4cCI6MjEwMzYwMzkxNn0.Vrtk4z0CW3t7XQEAl3jtLshPNrqXQU53-mWbjZv-eIo');
    document.getElementById('contact-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('button[type="submit"]');
      const originalText = btn.textContent;
      btn.disabled = true; btn.textContent = 'Enviando...';
      try {
        const { error } = await sb.from('messages').insert({
          name: document.getElementById('name').value,
          email: document.getElementById('email').value,
          phone: document.getElementById('phone').value,
          message: document.getElementById('message').value
        });
        if (error) throw error;
        btn.textContent = '✅ ¡Mensaje enviado!';
        e.target.reset();
        setTimeout(() => { btn.disabled = false; btn.textContent = originalText; }, 3000);
      } catch (err) {
        alert('Error al enviar: ' + err.message);
        btn.disabled = false; btn.textContent = originalText;
      }
    });
  </script>
</PublicLayout>
