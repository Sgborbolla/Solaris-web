---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase.js';
const { data: products } = await supabase.from('products').select('*').order('created_at', { ascending: false });
---
<AdminLayout title="Gestionar Productos" activeTab="productos">
  <div class="min-h-screen bg-solaris-gray">
    <header class="bg-white border-b border-solaris-border shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center h-16">
        <div class="flex items-center gap-4">
          <a href="/admin/dashboard" class="text-solaris-dark font-bold text-xl">SOLARIS</a>
          <span class="text-xs bg-solaris-primary/10 text-solaris-primary px-2 py-1 rounded-pill font-semibold">ADMIN</span>
        </div>
        <div class="flex items-center gap-4">
          <a href="/admin/dashboard" class="text-sm text-solaris-text hover:text-solaris-primary">← Dashboard</a>
          <button id="logout-btn" class="text-sm text-red-500 hover:text-red-700 font-medium">Cerrar Sesión</button>
        </div>
      </div>
    </header>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-solaris-dark">📦 Productos</h1>
        <button id="add-btn" class="btn-primary">+ Agregar Producto</button>
      </div>

      <!-- Modal -->
      <div id="modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-card w-full max-w-lg max-h-[90vh] overflow-y-auto p-6">
          <h2 id="modal-title" class="text-2xl font-bold text-solaris-dark mb-6">Agregar Producto</h2>
          <form id="product-form" class="space-y-4">
            <input type="hidden" id="product-id" />
            <input type="hidden" id="p-image-url" />
            
            <div>
              <label class="block text-sm font-semibold mb-2">Imagen del Producto</label>
              <div id="image-preview-container" class="mb-3 hidden">
                <div class="relative inline-block">
                  <img id="image-preview" src="" alt="Preview" class="w-32 h-32 object-cover rounded-card border-2 border-solaris-border" />
                  <button type="button" id="remove-image" class="absolute -top-2 -right-2 w-6 h-6 bg-red-500 text-white rounded-full flex items-center justify-center text-xs hover:bg-red-600">×</button>
                </div>
              </div>
              <label class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-solaris-border rounded-card cursor-pointer hover:border-solaris-primary hover:bg-solaris-gray/50 transition-all">
                <div class="flex flex-col items-center justify-center pt-5 pb-6">
                  <svg class="w-10 h-10 mb-3 text-solaris-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                  </svg>
                  <p class="text-sm text-solaris-text"><span class="font-semibold text-solaris-primary">Toca para seleccionar</span></p>
                  <p class="text-xs text-solaris-text mt-1">PNG, JPG o WEBP (máx. 5MB)</p>
                </div>
                <input type="file" id="p-image-file" accept="image/*" class="hidden" />
              </label>
              <div id="upload-progress" class="hidden mt-3">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs text-solaris-text">Subiendo...</span>
                  <span id="progress-percent" class="text-xs font-semibold text-solaris-primary">0%</span>
                </div>
                <div class="w-full bg-solaris-gray rounded-full h-2">
                  <div id="progress-bar" class="bg-solaris-primary h-2 rounded-full transition-all" style="width: 0%"></div>
                </div>
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold mb-1">Nombre</label>
              <input type="text" id="p-name" required class="w-full px-4 py-3 border border-solaris-border rounded-card outline-none focus:ring-2 focus:ring-solaris-primary" />
            </div>
            <div>
              <label class="block text-sm font-semibold mb-1">Categoría</label>
              <select id="p-category" class="w-full px-4 py-3 border border-solaris-border rounded-card outline-none focus:ring-2 focus:ring-solaris-primary">
                <option value="Paneles">Paneles</option>
                <option value="Inversores">Inversores</option>
                <option value="Baterías">Baterías</option>
                <option value="Accesorios">Accesorios</option>
          <option value="kits">Kits Solares</option>
          <option value="ecoflow">EcoFlow</option>
          <option value="componentes">Otros Componentes</option>

              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold mb-1">Precio (USD)</label>
              <input type="number" id="p-price" step="0.01" required class="w-full px-4 py-3 border border-solaris-border rounded-card outline-none focus:ring-2 focus:ring-solaris-primary" />
            </div>
            <div>
              <label class="block text-sm font-semibold mb-1">Descripción</label>
              <textarea id="p-desc" rows="3" class="w-full px-4 py-3 border border-solaris-border rounded-card outline-none focus:ring-2 focus:ring-solaris-primary resize-none"></textarea>
            </div>
            <div id="form-error" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-card text-sm"></div>
            <div id="form-success" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-card text-sm"></div>
            <div class="flex gap-3 pt-4">
              <button type="submit" id="save-btn" class="btn-primary flex-1 justify-center">💾 Guardar Cambios</button>
              <button type="button" id="cancel-btn" class="flex-1 py-3 border border-solaris-border rounded-card text-solaris-text hover:bg-solaris-gray">Cancelar</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Lista -->
      <div class="card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-solaris-gray">
              <tr>
                <th class="text-left px-6 py-4 text-sm font-semibold text-solaris-text">Producto</th>
                <th class="text-left px-6 py-4 text-sm font-semibold text-solaris-text">Categoría</th>
                <th class="text-left px-6 py-4 text-sm font-semibold text-solaris-text">Precio</th>
                <th class="text-right px-6 py-4 text-sm font-semibold text-solaris-text">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {(products || []).map((p) => (
                <tr class="border-t border-solaris-border hover:bg-solaris-gray/50">
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                      <img src={p.image || 'https://via.placeholder.com/40'} alt="" class="w-10 h-10 rounded-lg object-cover" />
                      <span class="font-medium text-solaris-dark">{p.name}</span>
                    </div>
                  </td>
                  <td class="px-6 py-4"><span class="text-xs bg-blue-100 text-solaris-primary px-2 py-1 rounded-pill font-semibold">{p.category}</span></td>
                  <td class="px-6 py-4 font-bold text-solaris-primary">${p.price}</td>
                  <td class="px-6 py-4 text-right">
                    <button data-id={p.id} data-name={p.name} data-category={p.category} data-price={p.price} data-image={p.image || ''} data-desc={p.description || ''} class="edit-btn text-solaris-primary hover:underline text-sm mr-3">Editar</button>
                    <button data-id={p.id} class="delete-btn text-red-500 hover:underline text-sm">Eliminar</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline>
    const sb = window.supabase.createClient('https://djyysffxpbvbfkcmrhta.supabase.co','eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRqeXlzZmZ4cGJ2YmZrY21yaHRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMjc5MTYsImV4cCI6MjEwMzYwMzkxNn0.Vrtk4z0CW3t7XQEAl3jtLshPNrqXQU53-mWbjZv-eIo');
    
    // Función para mostrar mensajes en pantalla
    function mostrarMensaje(texto, tipo = 'info') {
      const div = document.createElement('div');
      div.style.cssText = 'position:fixed;top:80px;left:50%;transform:translateX(-50%);padding:12px 20px;border-radius:8px;z-index:9999;font-size:14px;max-width:90%;box-shadow:0 4px 6px rgba(0,0,0,0.1);';
      if (tipo === 'error') {
        div.style.background = '#fee2e2';
        div.style.color = '#991b1b';
        div.style.border = '1px solid #fecaca';
      } else if (tipo === 'success') {
        div.style.background = '#d1fae5';
        div.style.color = '#065f46';
        div.style.border = '1px solid #a7f3d0';
      } else {
        div.style.background = '#dbeafe';
        div.style.color = '#1e40af';
        div.style.border = '1px solid #bfdbfe';
      }
      div.textContent = texto;
      document.body.appendChild(div);
      setTimeout(() => div.remove(), 4000);
    }
    
    sb.auth.getSession().then(({ data }) => { 
      if (!data.session) window.location.href = '/admin/login'; 
    });
    
    document.getElementById('logout-btn').addEventListener('click', async () => { 
      await sb.auth.signOut(); 
      window.location.href = '/admin/login'; 
    });

    const modal = document.getElementById('modal');
    const fileInput = document.getElementById('p-image-file');
    const imagePreview = document.getElementById('image-preview');
    const previewContainer = document.getElementById('image-preview-container');
    const imageUrlField = document.getElementById('p-image-url');
    const formError = document.getElementById('form-error');
    const formSuccess = document.getElementById('form-success');
    let selectedFile = null;

    document.getElementById('add-btn').addEventListener('click', () => {
      document.getElementById('modal-title').textContent = 'Agregar Producto';
      document.getElementById('product-form').reset();
      document.getElementById('product-id').value = '';
      imageUrlField.value = '';
      previewContainer.classList.add('hidden');
      formError.classList.add('hidden');
      formSuccess.classList.add('hidden');
      selectedFile = null;
      modal.classList.remove('hidden');
    });

    document.getElementById('cancel-btn').addEventListener('click', () => modal.classList.add('hidden'));

    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) {
        mostrarMensaje('❌ La imagen no debe superar los 5MB', 'error');
        return;
      }
      selectedFile = file;
      mostrarMensaje('✅ Imagen seleccionada: ' + file.name, 'success');
      const reader = new FileReader();
      reader.onload = (e) => {
        imagePreview.src = e.target.result;
        previewContainer.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    });

    document.getElementById('remove-image').addEventListener('click', () => {
      selectedFile = null;
      fileInput.value = '';
      previewContainer.classList.add('hidden');
      imageUrlField.value = '';
    });

    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('modal-title').textContent = 'Editar Producto';
        document.getElementById('product-id').value = btn.dataset.id;
        document.getElementById('p-name').value = btn.dataset.name;
        document.getElementById('p-category').value = btn.dataset.category;
        document.getElementById('p-price').value = btn.dataset.price;
        document.getElementById('p-desc').value = btn.dataset.desc;
        imageUrlField.value = btn.dataset.image;
        if (btn.dataset.image) {
          imagePreview.src = btn.dataset.image;
          previewContainer.classList.remove('hidden');
        } else {
          previewContainer.classList.add('hidden');
        }
        selectedFile = null;
        formError.classList.add('hidden');
        formSuccess.classList.add('hidden');
        modal.classList.remove('hidden');
      });
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar este producto?')) return;
        const { error } = await sb.from('products').delete().eq('id', btn.dataset.id);
        if (error) {
          mostrarMensaje('❌ Error al eliminar: ' + error.message, 'error');
        } else {
          mostrarMensaje('✅ Producto eliminado', 'success');
          setTimeout(() => location.reload(), 1000);
        }
      });
    });

    document.getElementById('product-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('save-btn');
      const saveText = document.getElementById('save-text');
      const id = document.getElementById('product-id').value;
      
      saveBtn.disabled = true;
      saveText.textContent = 'Guardando...';
      formError.classList.add('hidden');
      formSuccess.classList.add('hidden');
      
      try {
        let imageUrl = imageUrlField.value;
        
        if (selectedFile) {
          mostrarMensaje('📤 Subiendo imagen...', 'info');
          const fileName = `${Date.now()}_${selectedFile.name.replace(/\s/g, '_')}`;
          const { data: uploadData, error: uploadError } = await sb.storage
            .from('products')
            .upload(fileName, selectedFile);
          
          if (uploadError) {
            throw new Error('Error al subir imagen: ' + uploadError.message);
          }
          
          const { data: urlData } = sb.storage.from('products').getPublicUrl(fileName);
          imageUrl = urlData.publicUrl;
          mostrarMensaje('✅ Imagen subida correctamente', 'success');
        }
        
        const productData = {
          name: document.getElementById('p-name').value,
          category: document.getElementById('p-category').value,
          price: parseFloat(document.getElementById('p-price').value),
          image: imageUrl,
          description: document.getElementById('p-desc').value,
          is_active: true
        };
        
        let result;
        if (id) {
          result = await sb.from('products').update(productData).eq('id', id);
        } else {
          result = await sb.from('products').insert(productData);
        }
        
        if (result.error) {
          throw new Error('Error al guardar: ' + result.error.message);
        }
        
        mostrarMensaje('✅ ¡Producto guardado correctamente!', 'success');
        setTimeout(() => location.reload(), 1500);
        
      } catch (err) {
        formError.textContent = '❌ ' + err.message;
        formError.classList.remove('hidden');
        mostrarMensaje('❌ ' + err.message, 'error');
        saveBtn.disabled = false;
        saveText.textContent = 'Guardar';
      }
    });
  </script>
</AdminLayout>
