---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Login Admin">
  <div class="min-h-screen flex items-center justify-center bg-solaris-gray px-4 py-12">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <div class="flex items-center justify-center gap-2 mb-4">
          <img src="/logo-solaris.svg" alt="Solaris" class="w-28 h-28 mx-auto mb-6 drop-shadow-lg" />
          <span class="text-3xl font-bold text-solaris-dark">SOLARIS</span>
        </div>
        <h1 class="text-2xl font-bold text-solaris-dark">Panel de Administración</h1>
        <p class="text-solaris-text mt-2">Ingresa tus credenciales</p>
      </div>
      <div class="card p-8">
        <form id="login-form" class="space-y-6">
          <div>
            <label class="block text-sm font-semibold text-solaris-dark mb-2">Correo</label>
            <input type="email" id="email" required class="w-full px-4 py-3 border border-solaris-border rounded-card focus:ring-2 focus:ring-solaris-primary outline-none" placeholder="admin@solaris.com" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-solaris-dark mb-2">Contraseña</label>
            <input type="password" id="password" required class="w-full px-4 py-3 border border-solaris-border rounded-card focus:ring-2 focus:ring-solaris-primary outline-none" placeholder="••••••••" />
          </div>
          <div id="error-msg" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-card text-sm"></div>
          <button type="submit" id="submit-btn" class="w-full btn-primary justify-center py-3 font-semibold">
            <span id="btn-text">Iniciar Sesión</span>
          </button>
        </form>
        <div class="mt-6 text-center">
          <a href="/" class="text-sm text-solaris-text hover:text-solaris-primary">← Volver al sitio</a>
        </div>
      </div>
    </div>
  </div>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline>
    const sb = window.supabase.createClient(
      'https://djyysffxpbvbfkcmrhta.supabase.co',
      'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRqeXlzZmZ4cGJ2YmZrY21yaHRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMjc5MTYsImV4cCI6MjEwMzYwMzkxNn0.Vrtk4z0CW3t7XQEAl3jtLshPNrqXQU53-mWbjZv-eIo'
    );
    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const btn = document.getElementById('submit-btn');
      const btnText = document.getElementById('btn-text');
      const errMsg = document.getElementById('error-msg');
      btn.disabled = true;
      btnText.textContent = 'Verificando...';
      errMsg.classList.add('hidden');
      const { data, error } = await sb.auth.signInWithPassword({ email, password });
      if (error) {
        errMsg.textContent = error.message === 'Invalid login credentials' ? 'Correo o contraseña incorrectos' : error.message;
        errMsg.classList.remove('hidden');
        btn.disabled = false;
        btnText.textContent = 'Iniciar Sesión';
      } else {
        btnText.textContent = '¡Bienvenido! Redirigiendo...';
        setTimeout(() => { window.location.href = '/admin/dashboard'; }, 800);
      }
    });
  </script>
</BaseLayout>
