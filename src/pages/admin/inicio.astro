---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase.js';

// Obtener datos de hero_content (la tabla correcta que usa el script)
const { data: heroContentData } = await supabase.from('hero_content').select('*').single();
const hero = heroContentData || {};

// Obtener galería
const { data: galleryData } = await supabase.from('gallery_images').select('*');
const gallerySlots = galleryData || [];

// Para compatibilidad con el HTML que usa hero.background_image
const hero_image = hero?.background_image || '';
---
<AdminLayout title="Editar Inicio" activeTab="inicio">
  <header class="bg-white border-b border-solaris-border shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center h-16">
      <div class="flex items-center gap-4">
        <a href="/admin/dashboard" class="text-solaris-dark font-bold text-xl">SOLARIS</a>
        <span class="text-xs bg-solaris-accent/10 text-solaris-accent px-2 py-1 rounded-pill font-semibold">EDITAR INICIO</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/admin/dashboard" class="text-sm text-solaris-text">← Dashboard</a>
        <button id="logout-btn" class="text-sm text-red-500 font-medium">Salir</button>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-24">
    <h1 class="text-3xl font-bold text-solaris-dark mb-8">🏠 Editar Página de Inicio</h1>

    

    <!-- HERO (cuadro bonito para la imagen de fondo) -->
    <div class="card p-6 mb-6">
      <h2 class="text-2xl font-bold text-solaris-dark mb-4">🎯 Sección Hero (Foto grande principal)</h2>
      <p class="text-sm text-solaris-text mb-6">Edita la imagen de fondo y el texto que aparece sobre ella.</p>
      
      <form id="hero-form" class="space-y-4">
        <input type="hidden" id="hero-id" value={hero?.id || ''} />
        
                <!-- IMAGEN DE FONDO -->
    <div class="bg-blue-50 border border-blue-200 rounded-card p-4">
      <label class="block text-sm font-semibold mb-2">📸 Imagen de Fondo del Hero</label>
      <p class="text-xs text-solaris-text mb-3">Sube la imagen que aparecerá de fondo</p>

      {hero?.background_image ? (
        <div class="relative w-full rounded-card overflow-hidden border-2 border-solaris-border mb-3">
          <img src={hero.background_image} alt="Fondo actual" class="w-full h-48 object-cover" />
          <div class="flex gap-2 p-2 bg-solaris-gray/50 border-t border-solaris-border">
            <!-- El LABEL abre la galería nativamente en el celular, sin JS -->
            <label for="hero-image" class="flex-1 bg-white text-solaris-dark border border-solaris-border px-3 py-2 rounded text-sm font-semibold shadow-sm active:scale-95 transition-transform text-center cursor-pointer">
              🔄 Reemplazar
              <input type="file" id="hero-image" name="hero_image" accept="image/*" class="hidden" />
            </label>
            <button type="button" id="delete-hero-btn" class="flex-1 bg-red-500 text-white px-3 py-2 rounded text-sm font-semibold shadow-sm active:scale-95 transition-transform">🗑️ Eliminar</button>
          </div>
        </div>
      ) : (
        <label for="hero-image" class="flex flex-col items-center justify-center w-full h-48 border-2 border-dashed border-solaris-border rounded-card cursor-pointer hover:border-solaris-primary hover:bg-solaris-gray/50 transition-all bg-white">
          <div class="flex flex-col items-center justify-center p-6">
            <svg class="w-16 h-16 mb-4 text-solaris-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-solaris-text font-semibold text-lg">Toca para subir imagen de fondo</p>
            <p class="text-xs text-solaris-text mt-2">PNG, JPG o WEBP</p>
          </div>
          <input type="file" id="hero-image" name="hero_image" accept="image/*" class="hidden" />
        </label>
      )}

      <div id="hero-upload-progress" class="hidden mt-3">
        <div class="flex items-center justify-between mb-1">
          <span class="text-xs text-solaris-text">Subiendo...</span>
          <span id="hero-progress-percent" class="text-xs font-semibold text-solaris-primary">0%</span>
        </div>
        <div class="w-full bg-solaris-gray rounded-full h-2">
          <div id="hero-progress-bar" class="bg-solaris-primary h-2 rounded-full transition-all" style="width: 0%"></div>
        </div>
      </div>
      <div id="hero-upload-success" class="hidden mt-3 bg-green-50 border border-green-200 text-green-700 px-4 py-2 rounded-card text-sm">✅ Carga exitosa</div>
    </div>

        <!-- TEXTOS -->
        <div>
          <label class="block text-sm font-semibold mb-2">Título Principal</label>
          <input type="text" id="hero-title" value={hero?.title || ''} class="w-full px-4 py-3 border border-solaris-border rounded-card outline-none focus:ring-2 focus:ring-solaris-primary" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-2">Subtítulo</label>
          <textarea id="hero-subtitle" rows="3" class="w-full px-4 py-3 border border-solaris-border rounded-card outline-none focus:ring-2 focus:ring-solaris-primary resize-none">{hero?.subtitle || ''}</textarea>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold mb-2">Texto del Botón</label>
            <input type="text" id="hero-cta" value={hero?.cta_text || ''} class="w-full px-4 py-3 border border-solaris-border rounded-card outline-none focus:ring-2 focus:ring-solaris-primary" />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-2">Enlace del Botón</label>
            <input type="text" id="hero-link" value={hero?.cta_link || ''} class="w-full px-4 py-3 border border-solaris-border rounded-card outline-none focus:ring-2 focus:ring-solaris-primary" />
          </div>
        </div>
        
        <button type="submit" class="btn-primary w-full justify-center">💾 Guardar Hero</button>
      </form>
    </div>

    <!-- VIDEO -->
    <div class="card p-6 mb-6">
      <h2 class="text-2xl font-bold text-solaris-dark mb-4">🎥 Video Promocional</h2>
      <form id="video-form" class="space-y-4">
        <div>
          <label class="block text-sm font-semibold mb-2">Subir Video desde tu Dispositivo</label>
          <p class="text-xs text-solaris-text mb-2">MP4, MOV o WebM (máx. 50MB)</p>
          <label class="flex flex-col items-center justify-center w-full h-48 border-2 border-dashed border-solaris-border rounded-card cursor-pointer hover:border-solaris-primary hover:bg-solaris-gray/50 transition-all">
            <div class="flex flex-col items-center justify-center p-6">
              <svg class="w-16 h-16 mb-4 text-solaris-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="text-solaris-text font-semibold text-lg">Toca para subir video</p>
              <p class="text-xs text-solaris-text mt-2">MP4, MOV o WebM</p>
            </div>
            <input type="file" id="video-file" accept="video/*" class="hidden" />
          </label>
          <div id="video-preview-container" class="mt-3 hidden">
            <video id="video-preview" controls class="w-full max-w-md rounded-card border border-solaris-border"></video>
            <button type="button" id="remove-video" class="mt-2 text-sm text-red-500 hover:underline">Quitar video</button>
          </div>
        </div>
        <button type="submit" class="btn-primary">💾 Guardar Video</button>
      </form>
    </div>

    <!-- GALERÍA - 2 SLOTS -->
    <div class="card p-6 mb-6">
      <h2 class="text-2xl font-bold text-solaris-dark mb-2">🖼️ Fotos Promocionales</h2>
      <p class="text-sm text-solaris-text mb-6">Sube 2 fotos grandes que se mostrarán en la página de inicio.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="gallery-slot" data-slot="0" data-id={gallerySlots?.[0]?.id || ''}>
          {gallerySlots?.[0] ? (
            <div class="relative aspect-[4/3] rounded-card overflow-hidden border-2 border-solaris-border group">
              <img src={gallerySlots?.[0].image_url} alt={gallerySlots?.[0].title} class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                <button class="replace-btn bg-white text-solaris-dark px-3 py-2 rounded text-sm font-semibold">Reemplazar</button>
                <button class="delete-slot-btn bg-red-500 text-white px-3 py-2 rounded text-sm font-semibold">Eliminar</button>
              </div>
              <div class="absolute bottom-0 left-0 right-0 bg-black/70 text-white p-3">
                <p class="font-semibold text-sm truncate">{gallerySlots?.[0].title}</p>
              </div>
            </div>
          ) : (
            <label class="upload-area flex flex-col items-center justify-center w-full aspect-[4/3] border-2 border-dashed border-solaris-border rounded-card cursor-pointer hover:border-solaris-primary hover:bg-solaris-gray/50 transition-all">
              <div class="flex flex-col items-center justify-center p-6">
                <svg class="w-16 h-16 mb-4 text-solaris-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <p class="text-solaris-text font-semibold text-lg">Toca para subir foto 1</p>
                <p class="text-xs text-solaris-text mt-2">PNG, JPG o WEBP</p>
              </div>
              <input type="file" class="slot-file-input hidden" accept="image/*" data-slot="0" />
            </label>
          )}
          <div class="upload-progress hidden mt-3">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs text-solaris-text">Subiendo...</span>
              <span class="progress-percent text-xs font-semibold text-solaris-primary">0%</span>
            </div>
            <div class="w-full bg-solaris-gray rounded-full h-2">
              <div class="progress-bar bg-solaris-primary h-2 rounded-full transition-all" style="width: 0%"></div>
            </div>
          </div>
          <div class="upload-success hidden mt-3 bg-green-50 border border-green-200 text-green-700 px-4 py-2 rounded-card text-sm">✅ Carga exitosa</div>
        </div>

        <div class="gallery-slot" data-slot="1" data-id={gallerySlots[1]?.id || ''}>
          {gallerySlots[1] ? (
            <div class="relative aspect-[4/3] rounded-card overflow-hidden border-2 border-solaris-border group">
              <img src={gallerySlots[1].image_url} alt={gallerySlots[1].title} class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                <button class="replace-btn bg-white text-solaris-dark px-3 py-2 rounded text-sm font-semibold">Reemplazar</button>
                <button class="delete-slot-btn bg-red-500 text-white px-3 py-2 rounded text-sm font-semibold">Eliminar</button>
              </div>
              <div class="absolute bottom-0 left-0 right-0 bg-black/70 text-white p-3">
                <p class="font-semibold text-sm truncate">{gallerySlots[1].title}</p>
              </div>
            </div>
          ) : (
            <label class="upload-area flex flex-col items-center justify-center w-full aspect-[4/3] border-2 border-dashed border-solaris-border rounded-card cursor-pointer hover:border-solaris-primary hover:bg-solaris-gray/50 transition-all">
              <div class="flex flex-col items-center justify-center p-6">
                <svg class="w-16 h-16 mb-4 text-solaris-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <p class="text-solaris-text font-semibold text-lg">Toca para subir foto 2</p>
                <p class="text-xs text-solaris-text mt-2">PNG, JPG o WEBP</p>
              </div>
              <input type="file" class="slot-file-input hidden" accept="image/*" data-slot="1" />
            </label>
          )}
          <div class="upload-progress hidden mt-3">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs text-solaris-text">Subiendo...</span>
              <span class="progress-percent text-xs font-semibold text-solaris-primary">0%</span>
            </div>
            <div class="w-full bg-solaris-gray rounded-full h-2">
              <div class="progress-bar bg-solaris-primary h-2 rounded-full transition-all" style="width: 0%"></div>
            </div>
          </div>
          <div class="upload-success hidden mt-3 bg-green-50 border border-green-200 text-green-700 px-4 py-2 rounded-card text-sm">✅ Carga exitosa</div>
        </div>
      </div>
    </div>

  </div>

  <div id="toast" class="hidden fixed top-20 right-4 bg-green-500 text-white px-6 py-3 rounded-card shadow-lg z-50"></div>

  
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script is:inline>
  const sb = window.supabase.createClient('https://djyysffxpbvbfkcmrhta.supabase.co', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRqeXlzZmZ4cGJ2YmZrY21yaHRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMjc5MTYsImV4cCI6MjEwMzYwMzkxNn0.Vrtk4z0CW3t7XQEAl3jtLshPNrqXQU53-mWbjZv-eIo');
  
  sb.auth.getSession().then(({ data }) => { 
    if (!data.session) window.location.href = '/admin/login'; 
  });
  
  document.getElementById('logout-btn')?.addEventListener('click', async () => { 
    await sb.auth.signOut(); 
    window.location.href = '/admin/login'; 
  });

  function showToast(msg) {
    let toast = document.getElementById('toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'toast';
      toast.className = 'fixed top-20 left-1/2 transform -translate-x-1/2 bg-solaris-dark text-white px-6 py-3 rounded-lg shadow-lg z-[100] transition-opacity duration-300 opacity-0';
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.style.opacity = '1';
    setTimeout(() => toast.style.opacity = '0', 3000);
  }

  async function uploadFile(file, bucket) {
    const fileName = `${Date.now()}_${file.name.replace(/\s/g, '_')}`;
    console.log('📤 Subiendo a bucket:', bucket, 'archivo:', fileName);
    const { data, error } = await sb.storage.from(bucket).upload(fileName, file);
    if (error) {
      console.error('❌ Error de subida:', error);
      throw new Error('Error al subir: ' + error.message);
    }
    const { data: urlData } = sb.storage.from(bucket).getPublicUrl(fileName);
    return urlData.publicUrl;
  }

  // --- LÓGICA DEL HERO ---
  const heroFileInput = document.getElementById('hero-image');
  const deleteHeroBtn = document.getElementById('delete-hero-btn');
  const heroIdInput = document.getElementById('hero-id');
  const heroId = heroIdInput ? heroIdInput.value : null;

  console.log('🔍 Hero ID encontrado:', heroId);

  if (heroFileInput) {
    heroFileInput.addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) { 
        showToast('❌ La imagen no debe superar los 5MB'); 
        heroFileInput.value = ''; 
        return; 
      }

      const progressDiv = document.getElementById('hero-upload-progress');
      const progressBar = document.getElementById('hero-progress-bar');
      const progressPercent = document.getElementById('hero-progress-percent');
      const successDiv = document.getElementById('hero-upload-success');

      if (progressDiv) progressDiv.classList.remove('hidden');
      if (successDiv) successDiv.classList.add('hidden');
      if (progressBar) progressBar.style.width = '30%';
      if (progressPercent) progressPercent.textContent = '30%';

      try {
        if (progressBar) progressBar.style.width = '60%';
        if (progressPercent) progressPercent.textContent = '60%';
        
        console.log('⏳ Iniciando subida a Supabase...');
        const imageUrl = await uploadFile(file, 'site');
        console.log('✅ Subida exitosa, URL:', imageUrl);
        
        if (progressBar) progressBar.style.width = '90%';
        if (progressPercent) progressPercent.textContent = '90%';

        if (heroId) {
          console.log('💾 Actualizando registro con ID:', heroId);
          const { error: updateError } = await sb.from('hero_content').update({ background_image: imageUrl }).eq('id', heroId);
          if (updateError) throw updateError;
        } else {
          console.log('💾 Insertando nuevo registro...');
          const { error: insertError } = await sb.from('hero_content').insert({ background_image: imageUrl });
          if (insertError) throw insertError;
        }

        if (progressBar) progressBar.style.width = '100%';
        if (progressPercent) progressPercent.textContent = '100%';

        if (progressDiv) progressDiv.classList.add('hidden');
        if (successDiv) {
          successDiv.classList.remove('hidden');
          showToast('✅ Imagen actualizada. Recargando...');
          setTimeout(() => location.reload(), 1500);
        }
      } catch (err) {
        console.error('💥 Error completo:', err);
        if (progressDiv) progressDiv.classList.add('hidden');
        showToast('❌ Error: ' + err.message);
        heroFileInput.value = '';
      }
    });
  }

  if (deleteHeroBtn) {
    deleteHeroBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      console.log('🗑️ Botón eliminar clickeado. Hero ID:', heroId);
      if (!confirm('¿Estás seguro de eliminar la IMAGEN DE FONDO del Hero?')) return;
      try {
        if (heroId) {
          const { error } = await sb.from('hero_content').update({ background_image: '' }).eq('id', heroId);
          if (error) throw error;
        }
        showToast('✅ Imagen de fondo eliminada. Recargando...');
        setTimeout(() => location.reload(), 1000);
      } catch (err) {
        console.error('💥 Error al eliminar:', err);
        showToast('❌ Error al eliminar: ' + err.message);
      }
    });
  }
</script>
</AdminLayout>
