---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase.js';

// Logo fijo (no editable)
const { data: logoData } = await supabase.from('site_settings').select('value').eq('key', 'site_logo').single();
const site_logo = logoData?.value || '/images/logo.png';

// Textos fijos (no editables desde el admin)
const { data: heroData } = await supabase.from('hero_content').select('*').single();
const hero = heroData || {};
---

<AdminLayout title="Editar Inicio" activeTab="inicio">
  <header class="bg-white border-b border-solaris-border shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center h-16">
      <div class="flex items-center gap-4">
        <a href="/admin/dashboard" class="text-solaris-dark font-bold text-xl">SOLARIS</a>
        <span class="text-xs bg-solaris-accent/10 text-solaris-accent px-2 py-1 rounded-pill font-semibold">EDITAR INICIO</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/admin/dashboard" class="text-sm text-solaris-text">← Dashboard</a>
        <button id="logout-btn" class="text-sm text-red-500 font-medium">Salir</button>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-24">
    <h1 class="text-3xl font-bold text-solaris-dark mb-8">🏠 Editar Página de Inicio</h1>

    <!-- LOGO (FIJO, NO EDITABLE) -->
    <div class="card p-6 mb-6">
      <h2 class="text-2xl font-bold text-solaris-dark mb-4">🏷️ Logotipo del Sitio</h2>
      <p class="text-sm text-solaris-text mb-4">Este logo está fijo y no se puede editar desde aquí.</p>
      <div class="flex items-center gap-4">
        <img src={site_logo} alt="Logo" class="h-16 object-contain" />
        <span class="text-sm text-solaris-text italic">(Fijo)</span>
      </div>
    </div>

    <!-- TEXTOS DEL HERO (FIJOS, NO EDITABLES) -->
    <div class="card p-6 mb-6">
      <h2 class="text-2xl font-bold text-solaris-dark mb-4">📝 Textos Principales</h2>
      <p class="text-sm text-solaris-text mb-4">Estos textos están fijos y no se pueden editar desde aquí.</p>
      <div class="space-y-3">
        <div>
          <span class="text-xs font-semibold text-solaris-text">TÍTULO:</span>
          <p class="text-lg font-bold">{hero.title || 'ENERGÍA PARA TU FUTURO'}</p>
        </div>
        <div>
          <span class="text-xs font-semibold text-solaris-text">SUBTÍTULO:</span>
          <p class="text-base">{hero.subtitle || 'Descubre cómo la energía solar puede transformar tu hogar y reducir tus costos hasta un 90%.'}</p>
        </div>
        <div>
          <span class="text-xs font-semibold text-solaris-text">BOTÓN:</span>
          <p class="text-base">{hero.cta_text || 'VER PRODUCTOS'} → {hero.cta_link || '/productos'}</p>
        </div>
      </div>
    </div>

    <!-- VIDEO PROMOCIONAL (EDITABLE) -->
    <div class="card p-6 mb-6">
      <h2 class="text-2xl font-bold text-solaris-dark mb-4">🎥 Video Promocional</h2>
      <p class="text-sm text-solaris-text mb-6">Sube o cambia el video que aparece en la página de inicio.</p>

      <form id="video-form" class="space-y-4">
        <input type="hidden" id="video-id" value={hero?.id || ''} />

        <div>
          <label class="block text-sm font-semibold mb-2">URL del Video (YouTube, Vimeo, etc.)</label>
          <input type="text" id="video-url" value={hero?.video_url || ''} placeholder="https://www.youtube.com/watch?v=..." class="w-full px-4 py-3 border border-solaris-border rounded-card outline-none focus:ring-2 focus:ring-solaris-primary" />
        </div>

        <button type="submit" id="btn-save-video" class="w-full bg-solaris-primary text-white font-bold py-3 rounded-lg shadow-lg active:scale-95 transition-transform text-lg">
          💾 Guardar Video
        </button>
      </form>
    </div>
  </div>
</AdminLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script is:inline>
  const sb = window.supabase.createClient('https://djyysffxpbvbfkcmrhta.supabase.co', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRqeXlzZmZ4cGJ2YmZrY21yaHRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMjc5MTYsImV4cCI6MjEwMzYwMzkxNn0.Vrtk4z0CW3t7XQEAl3jtLshPNrqXQU53-mWbjZv-eIo');
  
  sb.auth.getSession().then(({ data }) => { if (!data.session) window.location.href = '/admin/login'; });
  document.getElementById('logout-btn')?.addEventListener('click', async () => { await sb.auth.signOut(); window.location.href = '/admin/login'; });

  const videoForm = document.getElementById('video-form');
  const btnSaveVideo = document.getElementById('btn-save-video');

  if (videoForm) {
    videoForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const videoId = document.getElementById('video-id')?.value;
      const videoUrl = document.getElementById('video-url')?.value || '';

      btnSaveVideo.disabled = true;
      btnSaveVideo.innerHTML = '⏳ Guardando...';
      btnSaveVideo.style.backgroundColor = '#60a5fa';

      try {
        if (videoId) {
          const { error } = await sb.from('hero_content').update({ video_url: videoUrl }).eq('id', videoId);
          if (error) throw error;
        } else {
          const { error } = await sb.from('hero_content').insert({ video_url: videoUrl, title: 'ENERGÍA PARA TU FUTURO' });
          if (error) throw error;
        }

        btnSaveVideo.innerHTML = '✅ Guardado';
        btnSaveVideo.style.backgroundColor = '#22c55e';
        
        setTimeout(() => {
          btnSaveVideo.disabled = false;
          btnSaveVideo.innerHTML = '💾 Guardar Video';
          btnSaveVideo.style.backgroundColor = '#2563eb';
          alert('✅ Video guardado correctamente.');
        }, 1500);

      } catch (err) {
        alert('❌ Error al guardar: ' + err.message);
        btnSaveVideo.disabled = false;
        btnSaveVideo.innerHTML = '💾 Guardar Video';
        btnSaveVideo.style.backgroundColor = '#2563eb';
      }
    });
  }
</script>
