<script is:inline>
  const sb = window.supabase.createClient('https://djyysffxpbvbfkcmrhta.supabase.co', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRqeXlzZmZ4cGJ2YmZrY21yaHRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMjc5MTYsImV4cCI6MjEwMzYwMzkxNn0.Vrtk4z0CW3t7XQEAl3jtLshPNrqXQU53-mWbjZv-eIo');
  
  const heroId = document.getElementById('hero-id')?.value;
  const fileInput = document.getElementById('hero-file-input');
  const previewContainer = document.getElementById('hero-preview-container');
  const previewImg = document.getElementById('hero-preview');
  const progressDiv = document.getElementById('hero-progress');
  const progressBar = document.getElementById('hero-progress-bar');
  const progressText = document.getElementById('hero-progress-text');
  const btnSave = document.getElementById('btn-save-hero');
  const btnDelete = document.getElementById('btn-delete-hero');

  // 1. SUBIR IMAGEN
  if (fileInput) {
    fileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) { alert('❌ La imagen no debe superar los 5MB'); return; }

      const reader = new FileReader();
      reader.onload = (ev) => { previewImg.src = ev.target.result; previewContainer.classList.remove('hidden'); };
      reader.readAsDataURL(file);

      progressDiv.classList.remove('hidden');
      progressBar.style.width = '30%'; progressText.textContent = '30%';

      try {
        const fileName = 'img_' + Date.now() + '_' + file.name.replace(/\s/g, '_');
        const { error: upErr } = await sb.storage.from('images').upload(fileName, file);
        if (upErr) throw new Error('Storage: ' + upErr.message);

        progressBar.style.width = '70%'; progressText.textContent = '70%';
        const { data: urlData } = sb.storage.from('images').getPublicUrl(fileName);
        
        if (heroId) {
          const { error: dbErr } = await sb.from('hero_content').update({ background_image: urlData.publicUrl }).eq('id', heroId);
          if (dbErr) throw new Error('DB: ' + dbErr.message);
        } else {
          const { error: dbErr } = await sb.from('hero_content').insert({ background_image: urlData.publicUrl, title: 'ENERGÍA PARA TU FUTURO' });
          if (dbErr) throw new Error('DB: ' + dbErr.message);
        }

        progressBar.style.width = '100%'; progressText.textContent = '100%';
        alert('✅ Imagen guardada correctamente. La página se recargará para mostrar los cambios.');
        setTimeout(() => location.reload(), 500);

      } catch (err) {
        alert('❌ Error: ' + err.message);
        progressDiv.classList.add('hidden');
        previewContainer.classList.add('hidden');
      }
      fileInput.value = '';
    });
  }

  // 2. ELIMINAR IMAGEN
  if (btnDelete) {
    btnDelete.addEventListener('click', async () => {
      if (!confirm('¿Estás seguro de eliminar la imagen de fondo?')) return;
      try {
        if (heroId) {
          const { error } = await sb.from('hero_content').update({ background_image: '' }).eq('id', heroId);
          if (error) throw new Error('DB: ' + error.message);
        }
        alert('✅ Imagen eliminada correctamente. La página se recargará.');
        setTimeout(() => location.reload(), 500);
      } catch (err) {
        alert('❌ Error al eliminar: ' + err.message);
      }
    });
  }

  // 3. GUARDAR TEXTOS
  if (btnSave) {
    btnSave.addEventListener('click', async () => {
      const title = document.getElementById('hero-title')?.value || '';
      const subtitle = document.getElementById('hero-subtitle')?.value || '';
      const cta_text = document.getElementById('hero-cta')?.value || '';
      const cta_link = document.getElementById('hero-link')?.value || '';

      btnSave.disabled = true;
      btnSave.innerHTML = '⏳ Guardando...';
      btnSave.style.backgroundColor = '#60a5fa';

      try {
        if (heroId) {
          const { error } = await sb.from('hero_content').update({ title, subtitle, cta_text, cta_link }).eq('id', heroId);
          if (error) throw new Error('DB: ' + error.message);
        } else {
          const { error } = await sb.from('hero_content').insert({ title, subtitle, cta_text, cta_link });
          if (error) throw new Error('DB: ' + error.message);
        }

        btnSave.innerHTML = '✅ Guardado';
        btnSave.style.backgroundColor = '#22c55e';
        
        setTimeout(() => {
          alert('✅ Textos guardados correctamente.');
          location.reload();
        }, 800);

      } catch (err) {
        alert('❌ Error al guardar: ' + err.message);
        btnSave.disabled = false;
        btnSave.innerHTML = '💾 Guardar Hero';
        btnSave.style.backgroundColor = '#2563eb';
      }
    });
  }

  // === CARGA DINÁMICA DE DATOS (Solución para sitios estáticos) ===
  async function cargarDatosHeroFrescos() {
    try {
      const { data, error } = await sb.from('hero_content').select('*').single();
      if (data && !error) {
        // 1. Rellenar los campos de texto
        const titleInput = document.getElementById('hero-title');
        const subtitleInput = document.getElementById('hero-subtitle');
        const ctaInput = document.getElementById('hero-cta');
        const linkInput = document.getElementById('hero-link');
        
        if (titleInput) titleInput.value = data.title || '';
        if (subtitleInput) subtitleInput.value = data.subtitle || '';
        if (ctaInput) ctaInput.value = data.cta_text || '';
        if (linkInput) linkInput.value = data.cta_link || '';

        // 2. Mostrar la imagen y los botones si existe
        if (data.background_image) {
          const imgContainer = document.getElementById('hero-img-container');
          const uploadBox = document.getElementById('hero-upload-box');
          const currentImg = document.getElementById('hero-current-img');
          
          if (imgContainer && uploadBox && currentImg) {
            currentImg.src = data.background_image;
            uploadBox.style.display = 'none';
            imgContainer.style.display = 'block';
          }
        }
      }
    } catch (err) {
      console.error('Error cargando datos frescos:', err);
    }
  }
  
  // Ejecutar apenas cargue la página
  cargarDatosHeroFrescos();


