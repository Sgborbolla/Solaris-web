---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase.js';

const { data: heroData } = await supabase.from('hero_content').select('*').order('id', { ascending: false }).limit(1);
const hero = heroData?.[0] || null;
const { data: gallery } = await supabase.from('gallery_images').select('*').eq('is_active', true).order('id', { ascending: true }).limit(2);
const { data: settings } = await supabase.from('site_settings').select('*');
const settingsObj = {};
settings?.forEach(s => { settingsObj[s.key] = s.value; });

const gallerySlots = [null, null];
gallery?.forEach((img, i) => { if (i < 2) gallerySlots[i] = img; });
---
<AdminLayout title="Editar Inicio" activeTab="inicio">
  <header class="bg-white border-b border-solaris-border shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center h-16">
      <div class="flex items-center gap-4">
        <a href="/admin/dashboard" class="text-solaris-dark font-bold text-xl">SOLARIS</a>
        <span class="text-xs bg-solaris-accent/10 text-solaris-accent px-2 py-1 rounded-pill font-semibold">EDITAR INICIO</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/admin/dashboard" class="text-sm text-solaris-text">← Dashboard</a>
        <button id="logout-btn" class="text-sm text-red-500 font-medium">Salir</button>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-24">
    <h1 class="text-3xl font-bold text-solaris-dark mb-8">🏠 Editar Página de Inicio</h1>

    

    
  <!-- Hero Section -->
  <div class="card p-6 mb-6">
    <h2 class="text-xl font-bold text-solaris-dark mb-4">🎨 Hero Principal</h2>
    <p class="text-solaris-text text-sm mb-4">Imagen principal que aparece en la página de inicio.</p>
    
    {hero_image && (
      <div class="mb-4">
        <img src={hero_image} alt="Hero actual" class="w-full h-64 object-cover rounded-lg mb-3" />
      </div>
    )}
    
    <form method="POST" enctype="multipart/form-data" class="space-y-4">
      <input type="hidden" name="action" value="update_hero" />
      
      <div>
        <label class="block text-sm font-semibold text-solaris-dark mb-2">Imagen del Hero</label>
        <input type="file" name="hero_image" accept="image/*" class="w-full px-4 py-2 border border-solaris-border rounded-lg bg-white" />
      </div>
      
      <div class="flex gap-2">
        <button type="submit" class="px-6 py-2 bg-solaris-primary text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors">
          {hero_image ? 'Reemplazar Imagen' : 'Subir Imagen'}
        </button>
        
        {hero_image && (
          <button type="submit" name="action" value="delete_hero" class="px-6 py-2 bg-red-500 text-white font-semibold rounded-lg hover:bg-red-600 transition-colors" onclick="return confirm('¿Seguro que deseas eliminar la imagen del hero?')">
            Eliminar Imagen
          </button>
        )}
      </div>
    </form>
  </div>
</div>
        </div>
        <button type="submit" class="btn-primary">💾 Guardar Video</button>
      </form>
    </div>

    <!-- GALERÍA - 2 SLOTS -->
    <div class="card p-6 mb-6">
      <h2 class="text-2xl font-bold text-solaris-dark mb-2">🖼️ Fotos Promocionales</h2>
      <p class="text-sm text-solaris-text mb-6">Sube 2 fotos grandes que se mostrarán en la página de inicio.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="gallery-slot" data-slot="0" data-id={gallerySlots[0]?.id || ''}>
          {gallerySlots[0] ? (
            <div class="relative aspect-[4/3] rounded-card overflow-hidden border-2 border-solaris-border group">
              <img src={gallerySlots[0].image_url} alt={gallerySlots[0].title} class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                <button class="replace-btn bg-white text-solaris-dark px-3 py-2 rounded text-sm font-semibold">Reemplazar</button>
                <button class="delete-slot-btn bg-red-500 text-white px-3 py-2 rounded text-sm font-semibold">Eliminar</button>
              </div>
              <div class="absolute bottom-0 left-0 right-0 bg-black/70 text-white p-3">
                <p class="font-semibold text-sm truncate">{gallerySlots[0].title}</p>
              </div>
            </div>
          ) : (
            <label class="upload-area flex flex-col items-center justify-center w-full aspect-[4/3] border-2 border-dashed border-solaris-border rounded-card cursor-pointer hover:border-solaris-primary hover:bg-solaris-gray/50 transition-all">
              <div class="flex flex-col items-center justify-center p-6">
                <svg class="w-16 h-16 mb-4 text-solaris-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <p class="text-solaris-text font-semibold text-lg">Toca para subir foto 1</p>
                <p class="text-xs text-solaris-text mt-2">PNG, JPG o WEBP</p>
              </div>
              <input type="file" class="slot-file-input hidden" accept="image/*" data-slot="0" />
            </label>
          )}
          <div class="upload-progress hidden mt-3">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs text-solaris-text">Subiendo...</span>
              <span class="progress-percent text-xs font-semibold text-solaris-primary">0%</span>
            </div>
            <div class="w-full bg-solaris-gray rounded-full h-2">
              <div class="progress-bar bg-solaris-primary h-2 rounded-full transition-all" style="width: 0%"></div>
            </div>
          </div>
          <div class="upload-success hidden mt-3 bg-green-50 border border-green-200 text-green-700 px-4 py-2 rounded-card text-sm">✅ Carga exitosa</div>
        </div>

        <div class="gallery-slot" data-slot="1" data-id={gallerySlots[1]?.id || ''}>
          {gallerySlots[1] ? (
            <div class="relative aspect-[4/3] rounded-card overflow-hidden border-2 border-solaris-border group">
              <img src={gallerySlots[1].image_url} alt={gallerySlots[1].title} class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                <button class="replace-btn bg-white text-solaris-dark px-3 py-2 rounded text-sm font-semibold">Reemplazar</button>
                <button class="delete-slot-btn bg-red-500 text-white px-3 py-2 rounded text-sm font-semibold">Eliminar</button>
              </div>
              <div class="absolute bottom-0 left-0 right-0 bg-black/70 text-white p-3">
                <p class="font-semibold text-sm truncate">{gallerySlots[1].title}</p>
              </div>
            </div>
          ) : (
            <label class="upload-area flex flex-col items-center justify-center w-full aspect-[4/3] border-2 border-dashed border-solaris-border rounded-card cursor-pointer hover:border-solaris-primary hover:bg-solaris-gray/50 transition-all">
              <div class="flex flex-col items-center justify-center p-6">
                <svg class="w-16 h-16 mb-4 text-solaris-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <p class="text-solaris-text font-semibold text-lg">Toca para subir foto 2</p>
                <p class="text-xs text-solaris-text mt-2">PNG, JPG o WEBP</p>
              </div>
              <input type="file" class="slot-file-input hidden" accept="image/*" data-slot="1" />
            </label>
          )}
          <div class="upload-progress hidden mt-3">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs text-solaris-text">Subiendo...</span>
              <span class="progress-percent text-xs font-semibold text-solaris-primary">0%</span>
            </div>
            <div class="w-full bg-solaris-gray rounded-full h-2">
              <div class="progress-bar bg-solaris-primary h-2 rounded-full transition-all" style="width: 0%"></div>
            </div>
          </div>
          <div class="upload-success hidden mt-3 bg-green-50 border border-green-200 text-green-700 px-4 py-2 rounded-card text-sm">✅ Carga exitosa</div>
        </div>
      </div>
    </div>

  </div>

  <div id="toast" class="hidden fixed top-20 right-4 bg-green-500 text-white px-6 py-3 rounded-card shadow-lg z-50"></div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline>
    const sb = window.supabase.createClient('https://djyysffxpbvbfkcmrhta.supabase.co','eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRqeXlzZmZ4cGJ2YmZrY21yaHRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMjc5MTYsImV4cCI6MjEwMzYwMzkxNn0.Vrtk4z0CW3t7XQEAl3jtLshPNrqXQU53-mWbjZv-eIo');
    sb.auth.getSession().then(({ data }) => { if (!data.session) window.location.href = '/admin/login'; });
    document.getElementById('logout-btn').addEventListener('click', async () => { await sb.auth.signOut(); window.location.href = '/admin/login'; });

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 3000);
    }

    async function uploadFile(file, bucket) {
      const fileName = `${Date.now()}_${file.name.replace(/\s/g, '_')}`;
      const { error } = await sb.storage.from(bucket).upload(fileName, file);
      if (error) throw error;
      const { data } = sb.storage.from(bucket).getPublicUrl(fileName);
      return data.publicUrl;
    }

    async function updateSetting(key, value) {
      await sb.from('site_settings').update({ value }).eq('key', key);
    }

    // ===== LOGO =====
    const logoFileInput = document.getElementById('logo-file');
    const logoPreviewContainer = document.getElementById('logo-preview-container');
    const logoPreview = document.getElementById('logo-preview');
    const logoProgress = document.getElementById('logo-upload-progress');
    const logoProgressBar = document.getElementById('logo-progress-bar');
    const logoProgressPercent = document.getElementById('logo-progress-percent');
    const logoSuccess = document.getElementById('logo-upload-success');
    let selectedLogoFile = null;

    logoFileInput?.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) { showToast('❌ La imagen no debe superar los 5MB'); return; }
      selectedLogoFile = file;
      const reader = new FileReader();
      reader.onload = (e) => { logoPreview.src = e.target.result; logoPreviewContainer.classList.remove('hidden'); };
      reader.readAsDataURL(file);
    });

    document.getElementById('remove-logo-preview')?.addEventListener('click', () => {
      selectedLogoFile = null; logoFileInput.value = ''; logoPreviewContainer.classList.add('hidden');
    });

    document.getElementById('replace-logo-btn')?.addEventListener('click', () => logoFileInput.click());

    document.getElementById('delete-logo-btn')?.addEventListener('click', async () => {
      if (!confirm('¿Eliminar el logo actual?')) return;
      await updateSetting('site_logo', '');
      showToast('✅ Logo eliminado');
      setTimeout(() => location.reload(), 1000);
    });

    document.getElementById('logo-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('button[type="submit"]');
      const originalText = btn.textContent;
      btn.disabled = true; btn.textContent = 'Guardando...';
      try {
        if (selectedLogoFile) {
          logoProgress.classList.remove('hidden');
          logoSuccess.classList.add('hidden');
          logoProgressBar.style.width = '30%';
          logoProgressPercent.textContent = '30%';
          const url = await uploadFile(selectedLogoFile, 'site');
          await updateSetting('site_logo', url);
          logoProgressBar.style.width = '100%';
          logoProgressPercent.textContent = '100%';
        }
        logoProgress.classList.add('hidden');
        logoSuccess.classList.remove('hidden');
        showToast('✅ Logo actualizado');
        setTimeout(() => location.reload(), 1500);
      } catch (err) {
        showToast('❌ ' + err.message);
        logoProgress.classList.add('hidden');
        btn.disabled = false; btn.textContent = originalText;
      }
    });

    // ===== HERO =====
    const heroImageInput = document.getElementById('hero-image');
    const heroPreviewContainer = document.getElementById('hero-preview-container');
    const heroPreview = document.getElementById('hero-preview');
    const heroProgress = document.getElementById('hero-upload-progress');
    const heroProgressBar = document.getElementById('hero-progress-bar');
    const heroProgressPercent = document.getElementById('hero-progress-percent');
    const heroSuccess = document.getElementById('hero-upload-success');
    let selectedHeroFile = null;

    heroImageInput?.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) { showToast('❌ La imagen no debe superar los 5MB'); return; }
      selectedHeroFile = file;
      const reader = new FileReader();
      reader.onload = (e) => { heroPreview.src = e.target.result; heroPreviewContainer.classList.remove('hidden'); };
      reader.readAsDataURL(file);
    });

    document.getElementById('remove-hero-preview')?.addEventListener('click', () => {
      selectedHeroFile = null; heroImageInput.value = ''; heroPreviewContainer.classList.add('hidden');
    });

    document.getElementById('replace-hero-btn')?.addEventListener('click', () => heroImageInput.click());

    document.getElementById('delete-hero-btn')?.addEventListener('click', async () => {
      if (!confirm('¿Eliminar la imagen de fondo?')) return;
      const id = document.getElementById('hero-id').value;
      if (id) await sb.from('hero_content').update({ background_image: '' }).eq('id', id);
      showToast('✅ Imagen eliminada');
      setTimeout(() => location.reload(), 1000);
    });

    document.getElementById('hero-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('button[type="submit"]');
      const originalText = btn.textContent;
      btn.disabled = true; btn.textContent = 'Guardando...';
      try {
        const id = document.getElementById('hero-id').value;
        const data = {
          title: document.getElementById('hero-title').value,
          subtitle: document.getElementById('hero-subtitle').value,
          cta_text: document.getElementById('hero-cta').value,
          cta_link: document.getElementById('hero-link').value
        };
        if (selectedHeroFile) {
          heroProgress.classList.remove('hidden');
          heroSuccess.classList.add('hidden');
          heroProgressBar.style.width = '30%';
          heroProgressPercent.textContent = '30%';
          data.background_image = await uploadFile(selectedHeroFile, 'site');
          heroProgressBar.style.width = '100%';
          heroProgressPercent.textContent = '100%';
        }
        if (id) await sb.from('hero_content').update(data).eq('id', id);
        else await sb.from('hero_content').insert(data);
        heroProgress.classList.add('hidden');
        heroSuccess.classList.remove('hidden');
        showToast('✅ Hero actualizado');
        setTimeout(() => location.reload(), 1500);
      } catch (err) {
        showToast('❌ ' + err.message);
        heroProgress.classList.add('hidden');
        btn.disabled = false; btn.textContent = originalText;
      }
    });

    // ===== VIDEO =====
    const videoFileInput = document.getElementById('video-file');
    const videoPreviewContainer = document.getElementById('video-preview-container');
    const videoPreview = document.getElementById('video-preview');
    let selectedVideoFile = null;

    videoFileInput?.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      if (file.size > 50 * 1024 * 1024) { showToast('❌ El video no debe superar los 50MB'); return; }
      selectedVideoFile = file;
      videoPreview.src = URL.createObjectURL(file);
      videoPreviewContainer.classList.remove('hidden');
    });

    document.getElementById('remove-video')?.addEventListener('click', () => {
      selectedVideoFile = null; videoFileInput.value = ''; videoPreviewContainer.classList.add('hidden');
    });

    document.getElementById('video-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('button[type="submit"]');
      const originalText = btn.textContent;
      btn.disabled = true; btn.textContent = 'Guardando...';
      try {
        if (!selectedVideoFile) { showToast('❌ Selecciona un video'); btn.disabled = false; btn.textContent = originalText; return; }
        showToast('📤 Subiendo video...');
        const fileName = `${Date.now()}_${selectedVideoFile.name.replace(/\s/g, '_')}`;
        const { error } = await sb.storage.from('videos').upload(fileName, selectedVideoFile);
        if (error) throw error;
        const { data } = sb.storage.from('videos').getPublicUrl(fileName);
        const id = document.getElementById('hero-id').value;
        if (id) await sb.from('hero_content').update({ video_url: data.publicUrl }).eq('id', id);
        else await sb.from('hero_content').insert({ video_url: data.publicUrl });
        showToast('✅ Video guardado');
        setTimeout(() => location.reload(), 1000);
      } catch (err) {
        showToast('❌ ' + err.message);
        btn.disabled = false; btn.textContent = originalText;
      }
    });

    // ===== GALERÍA =====
    document.querySelectorAll('.slot-file-input').forEach(input => {
      input.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        if (file.size > 5 * 1024 * 1024) { showToast('❌ La imagen no debe superar los 5MB'); return; }
        const slot = input.dataset.slot;
        const slotEl = document.querySelector(`.gallery-slot[data-slot="${slot}"]`);
        const progress = slotEl.querySelector('.upload-progress');
        const progressBar = slotEl.querySelector('.progress-bar');
        const progressPercent = slotEl.querySelector('.progress-percent');
        const success = slotEl.querySelector('.upload-success');
        progress.classList.remove('hidden'); success.classList.add('hidden');
        progressBar.style.width = '30%'; progressPercent.textContent = '30%';
        try {
          const imageUrl = await uploadFile(file, 'gallery');
          progressBar.style.width = '100%'; progressPercent.textContent = '100%';
          const slotId = slotEl.dataset.id;
          const fileName = file.name.replace(/\.[^/.]+$/, '');
          if (slotId) {
            await sb.from('gallery_images').update({ image_url: imageUrl, title: fileName, category: 'general', is_active: true }).eq('id', slotId);
          } else {
            const { data: inserted } = await sb.from('gallery_images').insert({ image_url: imageUrl, title: fileName, category: 'general', is_active: true }).select().single();
            if (inserted) slotEl.dataset.id = inserted.id;
          }
          setTimeout(() => { progress.classList.add('hidden'); success.classList.remove('hidden'); setTimeout(() => location.reload(), 1500); }, 500);
        } catch (err) { progress.classList.add('hidden'); showToast(' ' + err.message); }
      });
    });

    document.querySelectorAll('.replace-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const slot = btn.closest('.gallery-slot').dataset.slot;
        document.querySelector(`.slot-file-input[data-slot="${slot}"]`).click();
      });
    });

    document.querySelectorAll('.delete-slot-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar esta foto?')) return;
        const slotEl = btn.closest('.gallery-slot');
        const slotId = slotEl.dataset.id;
        if (slotId) { await sb.from('gallery_images').delete().eq('id', slotId); showToast('✅ Foto eliminada'); setTimeout(() => location.reload(), 1000); }
      });
    });
  </script>
</AdminLayout>
