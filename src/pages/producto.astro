---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout
  title="Producto"
  description="Detalle del producto"
  activeTab="productos"
>

  <div class="max-w-6xl mx-auto px-4 py-8">

    <a
      href="/productos"
      class="inline-flex items-center gap-2 text-solaris-text hover:text-solaris-primary mb-6 transition-colors"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      <span class="font-medium">Volver al catálogo</span>
    </a>

    <!-- Cargando -->
    <div id="product-loading" class="text-center py-16">
      <div class="inline-block w-10 h-10 border-4 border-solaris-primary border-t-transparent rounded-full animate-spin"></div>
      <p class="mt-4 text-solaris-text">Cargando producto...</p>
    </div>

    <!-- Error -->
    <div id="product-error" class="hidden card p-10 text-center">
      <h2 class="text-2xl font-bold text-solaris-dark mb-3">
        Producto no encontrado
      </h2>
      <p id="product-error-text" class="text-solaris-text mb-6"></p>

      <a
        href="/productos"
        class="inline-block px-6 py-3 bg-solaris-dark text-white rounded-card font-semibold"
      >
        Volver al catálogo
      </a>
    </div>

    <!-- Producto -->
    <div id="product-content" class="hidden">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">

        <!-- Imagen -->
        <div class="space-y-4">

          <div class="aspect-square rounded-card overflow-hidden bg-solaris-gray shadow-sm">
            <img
              id="product-image"
              src=""
              alt=""
              class="w-full h-full object-cover"
            />
          </div>

        </div>

        <!-- Información -->
        <div class="space-y-6">

          <div>
            <span
              id="product-category"
              class="inline-block bg-blue-100 text-solaris-primary text-xs font-bold px-3 py-1 rounded-pill mb-3"
            ></span>

            <h1
              id="product-name"
              class="text-3xl md:text-4xl font-bold text-solaris-dark leading-tight"
            ></h1>
          </div>

          <!-- Precio -->
          <div class="flex items-baseline gap-2 pb-6 border-b border-solaris-border">
            <span
              id="product-price"
              class="text-4xl font-extrabold text-solaris-primary"
            ></span>

            <span class="text-solaris-text text-sm">
              USD / unidad
            </span>
          </div>

          <!-- Descripción -->
          <div>
            <h3 class="text-lg font-semibold text-solaris-dark mb-3">
              Descripción del producto
            </h3>

            <p
              id="product-description"
              class="text-solaris-text leading-relaxed"
            ></p>
          </div>

          <!-- Información disponible -->
          <div class="card p-6">

            <h3 class="text-lg font-semibold text-solaris-dark mb-4 flex items-center gap-2">

              <svg
                class="w-5 h-5 text-solaris-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
                />
              </svg>

              Información del producto
            </h3>

            <div class="space-y-0">

              <div class="flex justify-between items-center py-3 border-b border-solaris-border">
                <span class="text-solaris-text">Categoría</span>
                <span
                  id="info-category"
                  class="text-solaris-dark font-semibold"
                ></span>
              </div>

              <div class="flex justify-between items-center py-3">
                <span class="text-solaris-text">Disponibilidad</span>
                <span class="text-green-600 font-semibold">
                  Disponible
                </span>
              </div>

            </div>
          </div>

          <!-- Contacto -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

            <a
              href="https://wa.me/"
              class="flex items-center justify-center gap-2 p-4 bg-green-500 text-white rounded-card font-semibold hover:opacity-90 transition-opacity"
            >
              WhatsApp
            </a>

            <a
              href="/contacto"
              class="flex items-center justify-center gap-2 p-4 bg-solaris-dark text-white rounded-card font-semibold hover:bg-solaris-primary transition-colors"
            >
              Contactar
            </a>

          </div>

        </div>
      </div>

    </div>

  </div>

</PublicLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script is:inline>
  const SUPABASE_URL = 'https://djyysffxpbvbfkcmrhta.supabase.co';
  const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRqeXlzZmZ4cGJ2YmZrY21yaHRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMjc5MTYsImV4cCI6MjEwMzYwMzkxNn0.Vrtk4z0CW3t7XQEAl3jtLshPNrqXQU53-mWbjZv-eIo';

  const loading = document.getElementById('product-loading');
  const errorBox = document.getElementById('product-error');
  const errorText = document.getElementById('product-error-text');
  const content = document.getElementById('product-content');

  const image = document.getElementById('product-image');
  const category = document.getElementById('product-category');
  const name = document.getElementById('product-name');
  const price = document.getElementById('product-price');
  const description = document.getElementById('product-description');
  const infoCategory = document.getElementById('info-category');

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  async function loadProduct() {
    try {

      const params = new URLSearchParams(window.location.search);
      const productId = params.get('id');

      if (!productId) {
        throw new Error('No se especificó ningún producto.');
      }

      if (!window.supabase) {
        throw new Error('No se pudo cargar Supabase.');
      }

      const client = window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_ANON_KEY
      );

      const { data, error } = await client
        .from('products')
        .select('*')
        .eq('id', productId)
        .eq('is_active', true)
        .single();

      if (error) {
        throw error;
      }

      if (!data) {
        throw new Error('El producto no existe o no está disponible.');
      }

      const product = data;

      image.src =
        product.image ||
        'https://images.unsplash.com/photo-1509391366360-2e959784a276?auto=format&fit=crop&w=800&q=80';

      image.alt = product.name || 'Producto solar';

      category.textContent = product.category || 'Solar';

      name.textContent = product.name || 'Producto solar';

      price.textContent =
        '$' +
        Number(product.price || 0).toLocaleString('es-MX', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        });

      description.textContent =
        product.description ||
        'Información del producto disponible bajo consulta.';

      infoCategory.textContent =
        product.category || 'Solar';

      document.title = product.name || 'Producto';

      loading.classList.add('hidden');
      content.classList.remove('hidden');

    } catch (error) {

      console.error('Error cargando producto:', error);

      loading.classList.add('hidden');
      errorBox.classList.remove('hidden');

      errorText.textContent =
        error?.message ||
        'No fue posible cargar la información del producto.';
    }
  }

  loadProduct();
</script>
