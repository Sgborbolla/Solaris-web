---
import PublicLayout from '../layouts/PublicLayout.astro';

const images = [
  'https://images.unsplash.com/photo-1509391366360-2e959784a276?w=400',
  'https://images.unsplash.com/photo-1559302504-64aae6ca6b6d?w=400',
  'https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?w=400',
  'https://images.unsplash.com/photo-1558449028-b53a39d100fc?w=400'
];

const categories = ['Paneles', 'Inversores', 'Baterías', 'Accesorios'];

const names = [
  'Panel Monocristalino 450W',
  'Inversor Híbrido 5kW',
  'Batería Litio 48V',
  'Cable Solar 10mm'
];

const products = Array.from({ length: 20 }, (_, i) => ({
  id: i + 1,
  title: `${names[i % 4]} - Modelo ${i + 1}`,
  category: categories[i % 4],
  image: images[i % 4]
}));
---

<PublicLayout
  title="Productos"
  description="Catálogo de productos solares"
  isHome={false}
  activeTab="productos"
>
  <div class="max-w-6xl mx-auto px-4 py-8 md:py-12">

    <!-- Encabezado -->
    <div class="text-center mb-8 md:mb-10">
      <h1 class="text-3xl md:text-5xl font-bold text-solaris-dark mb-3 md:mb-4">
        Nuestros Productos
      </h1>

      <p class="text-base md:text-xl text-solaris-text">
        Soluciones de alta calidad para tu proyecto solar.
      </p>
    </div>

    <!-- Catálogo -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">

      {products.map((p) => (
        <a
          href={`/productos/${p.id}`}
          class="card overflow-hidden group hover:shadow-xl transition-all duration-300 block"
          aria-label={`Ver detalles de ${p.title}`}
        >

          <!-- Imagen -->
          <div class="aspect-square overflow-hidden bg-solaris-gray">
            <img
              src={p.image}
              alt={p.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>

          <!-- Información -->
          <div class="p-3 md:p-4">

            <span class="text-[10px] md:text-xs font-bold text-solaris-primary uppercase tracking-wider">
              {p.category}
            </span>

            <h2 class="text-sm md:text-base font-bold text-solaris-dark mt-1 md:mt-2 leading-tight line-clamp-2">
              {p.title}
            </h2>

            <div class="mt-3 w-full py-2 px-3 bg-solaris-dark text-white text-xs md:text-sm font-semibold rounded-card text-center group-hover:bg-solaris-primary transition-colors">
              Ver Detalles
            </div>

          </div>

        </a>
      ))}

    </div>

  </div>
</PublicLayout>
