---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout
  title="Productos"
  description="Catálogo de productos solares"
  isHome={false}
  activeTab="productos"
>
  <div class="max-w-6xl mx-auto px-4 py-8 md:py-12">

    <div class="text-center mb-8 md:mb-10">
      <h1 class="text-3xl md:text-5xl font-bold text-solaris-dark mb-3 md:mb-4">
        Nuestros Productos
      </h1>

      <p class="text-base md:text-xl text-solaris-text">
        Soluciones de alta calidad para tu proyecto solar.
      </p>
    </div>

    <div id="products-loading" class="text-center py-12">
      <div class="inline-block w-8 h-8 border-4 border-solaris-border border-t-solaris-primary rounded-full animate-spin"></div>
      <p class="mt-4 text-solaris-text">Cargando productos...</p>
    </div>

    <div
      id="products-grid"
      class="hidden grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6"
    ></div>

    <div id="products-empty" class="hidden text-center py-12">
      <p class="text-lg text-solaris-text">
        No hay productos disponibles.
      </p>
    </div>

    <div id="products-error" class="hidden text-center py-12">
      <p class="text-lg text-red-500">
        No se pudieron cargar los productos.
      </p>

      <button id="retry-btn" class="mt-4 btn-primary">
        Intentar nuevamente
      </button>
    </div>

    <div
      id="pagination"
      class="hidden flex items-center justify-center gap-3 mt-10 md:mt-12"
    >

      <button
        id="previous-btn"
        type="button"
        class="hidden px-3 md:px-4 py-2 text-sm font-semibold text-solaris-dark hover:text-solaris-primary transition-colors"
      >
        ← Anterior
      </button>

      <button
        id="page-1"
        type="button"
        class="w-10 h-10 rounded-full flex items-center justify-center font-bold transition-all"
      >
        1
      </button>

      <button
        id="page-2"
        type="button"
        class="w-10 h-10 rounded-full flex items-center justify-center font-bold transition-all"
      >
        2
      </button>

      <button
        id="next-btn"
        type="button"
        class="hidden px-3 md:px-4 py-2 text-sm font-semibold text-solaris-dark hover:text-solaris-primary transition-colors"
      >
        Siguiente →
      </button>

    </div>

  </div>
</PublicLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script is:inline>
  const SUPABASE_URL = 'https://djyysffxpbvbfkcmrhta.supabase.co';

  const SUPABASE_ANON_KEY =
    'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJ1cGFiYXNlIiwicmVmIjoiZGp5eXNlZmZ4cGJ2YmZrY21yaHRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMjc5MTYsImV4cCI6MjEwMzYwMzkxNn0.Vrtk3z0CW3t7XQEAl3jtLshPNrqXQU53-mWbjZv-eIo';

  const PRODUCTS_PER_PAGE = 14;
  const TOTAL_PAGES = 2;
  const MAX_PRODUCTS = 28;

  let allProducts = [];
  let currentPage = 1;

  const loading = document.getElementById('products-loading');
  const grid = document.getElementById('products-grid');
  const empty = document.getElementById('products-empty');
  const errorBox = document.getElementById('products-error');
  const pagination = document.getElementById('pagination');

  const page1 = document.getElementById('page-1');
  const page2 = document.getElementById('page-2');
  const previousBtn = document.getElementById('previous-btn');
  const nextBtn = document.getElementById('next-btn');
  const retryBtn = document.getElementById('retry-btn');

  const sb = window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_ANON_KEY
  );

  function escapeHtml(value) {
    const div = document.createElement('div');
    div.textContent = value ?? '';
    return div.innerHTML;
  }

  function renderProducts() {
    const start = (currentPage - 1) * PRODUCTS_PER_PAGE;
    const end = start + PRODUCTS_PER_PAGE;

    const pageProducts = allProducts.slice(start, end);

    grid.innerHTML = pageProducts.map((product) => {
      const image =
        product.image ||
        'https://via.placeholder.com/600x600?text=Solaris';

      const name =
        product.name ||
        'Producto Solaris';

      const category =
        product.category ||
        'Solar';

      return `
        <a
          href="/productos/${encodeURIComponent(product.id)}"
          class="card overflow-hidden group hover:shadow-xl transition-all duration-300 block"
          aria-label="Ver detalles de ${escapeHtml(name)}"
        >
          <div class="aspect-square overflow-hidden bg-solaris-gray">
            <img
              src="${escapeHtml(image)}"
              alt="${escapeHtml(name)}"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>

          <div class="p-3 md:p-4">

            <span
              class="text-[10px] md:text-xs font-bold text-solaris-primary uppercase tracking-wider"
            >
              ${escapeHtml(category)}
            </span>

            <h2
              class="text-sm md:text-base font-bold text-solaris-dark mt-1 md:mt-2 leading-tight line-clamp-2"
            >
              ${escapeHtml(name)}
            </h2>

            <div
              class="mt-3 w-full py-2 px-3 bg-solaris-dark text-white text-xs md:text-sm font-semibold rounded-card text-center group-hover:bg-solaris-primary transition-colors"
            >
              Ver Detalles
            </div>

          </div>
        </a>
      `;
    }).join('');

    updatePagination();

    loading.classList.add('hidden');
    grid.classList.remove('hidden');
    pagination.classList.remove('hidden');
  }

  function updatePagination() {
    page1.className =
      'w-10 h-10 rounded-full flex items-center justify-center font-bold transition-all';

    page2.className =
      'w-10 h-10 rounded-full flex items-center justify-center font-bold transition-all';

    if (currentPage === 1) {
      page1.classList.add(
        'bg-solaris-primary',
        'text-white',
        'shadow-md'
      );

      page2.classList.add(
        'bg-solaris-accent',
        'text-solaris-dark'
      );

      previousBtn.classList.add('hidden');
      nextBtn.classList.remove('hidden');

    } else {
      page1.classList.add(
        'bg-solaris-accent',
        'text-solaris-dark'
      );

      page2.classList.add(
        'bg-solaris-primary',
        'text-white',
        'shadow-md'
      );

      previousBtn.classList.remove('hidden');
      nextBtn.classList.add('hidden');
    }
  }

  function goToPage(page) {
    if (page < 1 || page > TOTAL_PAGES) {
      return;
    }

    currentPage = page;

    renderProducts();

    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  }

  async function loadProducts() {
    loading.classList.remove('hidden');
    grid.classList.add('hidden');
    empty.classList.add('hidden');
    errorBox.classList.add('hidden');
    pagination.classList.add('hidden');

    try {
      const { data, error } = await sb
        .from('products')
        .select('*')
        .eq('is_active', true)
        .order('created_at', { ascending: true })
        .limit(MAX_PRODUCTS);

      if (error) {
        throw error;
      }

      allProducts = data || [];

      if (allProducts.length === 0) {
        loading.classList.add('hidden');
        empty.classList.remove('hidden');
        return;
      }

      allProducts = allProducts.slice(0, MAX_PRODUCTS);

      currentPage = 1;

      renderProducts();

    } catch (err) {
      console.error('Error cargando productos desde Supabase:', err);

      loading.classList.add('hidden');
      errorBox.classList.remove('hidden');
    }
  }

  page1.addEventListener('click', () => {
    goToPage(1);
  });

  page2.addEventListener('click', () => {
    goToPage(2);
  });

  previousBtn.addEventListener('click', () => {
    goToPage(1);
  });

  nextBtn.addEventListener('click', () => {
    goToPage(2);
  });

  retryBtn.addEventListener('click', () => {
    loadProducts();
  });

  loadProducts();
</script>
