---
import PublicLayout from '../layouts/PublicLayout.astro';
---
<PublicLayout title="Perfil" isHome={false} activeTab="perfil">
  <div class="max-w-md mx-auto text-center py-12">
    <div class="card p-8">
      <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-solaris-primary/10 flex items-center justify-center">
        <svg class="w-10 h-10 text-solaris-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-solaris-dark mb-4">Mi Perfil</h1>
      <p class="text-solaris-text mb-6">Accede para gestionar el contenido del sitio.</p>
      <a href="/admin/login" class="btn-primary inline-flex justify-center w-full">
        Iniciar Sesión →
      </a>
    </div>
  </div>
</PublicLayout>
