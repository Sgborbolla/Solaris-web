---
interface Props {
  activeTab: string;
}
const { activeTab } = Astro.props;

const extraLinks = [
  { href: '/proyectos', label: 'Proyectos', icon: '️' },
  { href: '/faq', label: 'Preguntas Frecuentes', icon: '❓' },
  { href: '/contacto', label: 'Contacto', icon: '' },
  { href: '/servicios', label: 'Servicios', icon: '️' },
];
---

<!-- Barra inferior fija, fondo blanco, borde suave -->
<nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-100 shadow-[0_-2px_10px_rgba(0,0,0,0.05)] z-50">
  <div class="max-w-2xl mx-auto flex justify-around items-center h-16 px-2">
    
    <!-- 1. Inicio (Casa) -->
    <a href="/" class="flex flex-col items-center justify-center w-16 h-full transition-transform active:scale-90 {activeTab === 'inicio' ? 'text-yellow-500' : 'text-gray-400'}">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
    </a>

    <!-- 2. Productos (Cubo) -->
    <a href="/productos" class="flex flex-col items-center justify-center w-16 h-full transition-transform active:scale-90 {activeTab === 'productos' ? 'text-yellow-500' : 'text-gray-400'}">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
      </svg>
    </a>

    <!-- 3. Ahorro (Dólar en círculo) -->
    <a href="/ahorro" class="flex flex-col items-center justify-center w-16 h-full transition-transform active:scale-90 {activeTab === 'ahorro' ? 'text-yellow-500' : 'text-gray-400'}">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </a>

    <!-- 4. Perfil (Persona) -->
    <a href="/perfil" class="flex flex-col items-center justify-center w-16 h-full transition-transform active:scale-90 {activeTab === 'perfil' ? 'text-yellow-500' : 'text-gray-400'}">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
    </a>

    <!-- 5. Más (Tres puntos) -->
    <button id="btn-mas" class="flex flex-col items-center justify-center w-16 h-full transition-transform active:scale-90 text-gray-400 hover:text-yellow-500">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"/>
      </svg>
    </button>
  </div>
</nav>

<!-- Menú flotante que sale al tocar "Más" -->
<div id="menu-mas" class="hidden fixed bottom-20 right-4 bg-white border border-gray-100 shadow-2xl rounded-2xl p-2 z-50 w-56">
  <div class="px-4 py-2 text-xs font-bold text-gray-400 uppercase tracking-wider border-b border-gray-100 mb-1">Otras páginas</div>
  {extraLinks.map((link) => (
    <a href={link.href} class="flex items-center gap-3 px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 rounded-xl transition-colors">
      <span class="text-xl">{link.icon}</span> {link.label}
    </a>
  ))}
</div>

<script is:inline>
  const btn = document.getElementById('btn-mas');
  const menu = document.getElementById('menu-mas');
  if (btn && menu) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('hidden');
    });
    document.addEventListener('click', (e) => {
      if (!btn.contains(e.target) && !menu.contains(e.target)) {
        menu.classList.add('hidden');
      }
    });
  }
</script>
