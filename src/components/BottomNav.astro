---
interface Props {
  activeTab: string;
}
const { activeTab } = Astro.props;

const mainLinks = [
  { href: '/', label: 'Inicio', tab: 'inicio' },
  { href: '/productos', label: 'Productos', tab: 'productos' },
  { href: '/ahorro', label: 'Ahorro', tab: 'ahorro' },
  { href: '/perfil', label: 'Perfil', tab: 'perfil' },
];

const extraLinks = [
  { href: '/proyectos', label: 'Proyectos', icon: '🏗️' },
  { href: '/faq', label: 'Preguntas Frecuentes', icon: '❓' },
  { href: '/contacto', label: 'Contacto', icon: '📞' },
  { href: '/servicios', label: 'Servicios', icon: '🛠️' },
];
---

<nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-2xl z-50">
  <div class="max-w-4xl mx-auto px-2">
    <div class="flex justify-around items-center h-16">
      
      <!-- Inicio: Casa 3D -->
      <a href="/" class="flex flex-col items-center justify-center flex-1 h-full transition-transform active:scale-90">
        <svg class="w-7 h-7 mb-0.5 {activeTab === 'inicio' ? 'text-yellow-500 drop-shadow-lg' : 'text-gray-400'}" fill="currentColor" viewBox="0 0 24 24" style="filter: {activeTab === 'inicio' ? 'drop-shadow(0 2px 3px rgba(234, 179, 8, 0.5))' : 'none'}">
          <path d="M12 3L4 9v12h5v-7h6v7h5V9l-8-6z"/>
        </svg>
        <span class="text-[10px] font-bold {activeTab === 'inicio' ? 'text-yellow-500' : 'text-gray-400'}">Inicio</span>
      </a>

      <!-- Productos: Cubo 3D -->
      <a href="/productos" class="flex flex-col items-center justify-center flex-1 h-full transition-transform active:scale-90">
        <svg class="w-7 h-7 mb-0.5 {activeTab === 'productos' ? 'text-yellow-500 drop-shadow-lg' : 'text-gray-400'}" fill="currentColor" viewBox="0 0 24 24" style="filter: {activeTab === 'productos' ? 'drop-shadow(0 2px 3px rgba(234, 179, 8, 0.5))' : 'none'}">
          <path d="M21 16.5c0 .38-.21.71-.53.88l-7.9 4.44c-.16.12-.36.18-.57.18-.21 0-.41-.06-.57-.18l-7.9-4.44A.991.991 0 013 16.5v-9c0-.38.21-.71.53-.88l7.9-4.44c.16-.12.36-.18.57-.18.21 0 .41.06.57.18l7.9 4.44c.32.17.53.5.53.88v9zM12 4.15L6.04 7.5 12 10.85l5.96-3.35L12 4.15zM5 15.91l6 3.38v-6.71L5 9.21v6.7zm14 0v-6.7l-6 3.37v6.71l6-3.38z"/>
        </svg>
        <span class="text-[10px] font-bold {activeTab === 'productos' ? 'text-yellow-500' : 'text-gray-400'}">Productos</span>
      </a>

      <!-- Ahorro: Dólar 3D -->
      <a href="/ahorro" class="flex flex-col items-center justify-center flex-1 h-full transition-transform active:scale-90">
        <svg class="w-7 h-7 mb-0.5 {activeTab === 'ahorro' ? 'text-yellow-500 drop-shadow-lg' : 'text-gray-400'}" fill="currentColor" viewBox="0 0 24 24" style="filter: {activeTab === 'ahorro' ? 'drop-shadow(0 2px 3px rgba(234, 179, 8, 0.5))' : 'none'}">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1.41 16.09V20h-2.67v-1.93c-1.71-.36-3.16-1.46-3.27-3.4h1.96c.1 1.05.82 1.87 2.65 1.87 1.96 0 2.4-.98 2.4-1.59 0-.83-.44-1.61-2.67-2.14-2.48-.6-4.18-1.62-4.18-3.67 0-1.72 1.39-2.84 3.11-3.21V4h2.67v1.95c1.86.45 2.79 1.86 2.85 3.39H14.3c-.05-1.11-.64-1.87-2.22-1.87-1.5 0-2.4.68-2.4 1.64 0 .84.65 1.39 2.67 1.94s4.18 1.36 4.18 3.85c0 1.89-1.44 2.98-3.12 3.19z"/>
        </svg>
        <span class="text-[10px] font-bold {activeTab === 'ahorro' ? 'text-yellow-500' : 'text-gray-400'}">Ahorro</span>
      </a>

      <!-- Perfil: Persona 3D -->
      <a href="/perfil" class="flex flex-col items-center justify-center flex-1 h-full transition-transform active:scale-90">
        <svg class="w-7 h-7 mb-0.5 {activeTab === 'perfil' ? 'text-yellow-500 drop-shadow-lg' : 'text-gray-400'}" fill="currentColor" viewBox="0 0 24 24" style="filter: {activeTab === 'perfil' ? 'drop-shadow(0 2px 3px rgba(234, 179, 8, 0.5))' : 'none'}">
          <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
        </svg>
        <span class="text-[10px] font-bold {activeTab === 'perfil' ? 'text-yellow-500' : 'text-gray-400'}">Perfil</span>
      </a>

      <!-- Más: Tres puntos -->
      <button id="btn-mas" class="flex flex-col items-center justify-center flex-1 h-full transition-transform active:scale-90 text-gray-400 hover:text-yellow-500">
        <svg class="w-7 h-7 mb-0.5" fill="currentColor" viewBox="0 0 24 24">
          <circle cx="5" cy="12" r="2"/>
          <circle cx="12" cy="12" r="2"/>
          <circle cx="19" cy="12" r="2"/>
        </svg>
        <span class="text-[10px] font-bold">Más</span>
      </button>
    </div>
  </div>
</nav>

<!-- Menú flotante del botón Más -->
<div id="menu-mas" class="hidden fixed bottom-20 right-4 bg-white border border-gray-200 shadow-2xl rounded-2xl p-2 z-50 w-56">
  <div class="px-4 py-2 text-xs font-bold text-gray-500 uppercase tracking-wider border-b border-gray-200 mb-1">Otras páginas</div>
  {extraLinks.map((link) => (
    <a href={link.href} class="flex items-center gap-3 px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 rounded-xl transition-colors">
      <span class="text-xl">{link.icon}</span> {link.label}
    </a>
  ))}
</div>

<script is:inline>
  const btn = document.getElementById('btn-mas');
  const menu = document.getElementById('menu-mas');
  if (btn && menu) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('hidden');
    });
    document.addEventListener('click', (e) => {
      if (!btn.contains(e.target) && !menu.contains(e.target)) {
        menu.classList.add('hidden');
      }
    });
  }
</script>
