---
interface Props {
  activeTab: string;
  isAdmin?: boolean;
}

const { activeTab, isAdmin = false } = Astro.props;

const publicLinks = [
  { href: '/', label: 'Inicio', icon: '🏠', tab: 'inicio' },
  { href: '/productos', label: 'Productos', icon: '⚡', tab: 'productos' },
  { href: '/servicios', label: 'Servicios', icon: '', tab: 'servicios' },
  { href: '/contacto', label: 'Contacto', icon: '📞', tab: 'contacto' },
];

const adminLinks = [
  { href: '/admin', label: 'Dashboard', icon: '📊', tab: 'dashboard' },
  { href: '/admin/productos', label: 'Productos', icon: '', tab: 'productos' },
  { href: '/admin/pedidos', label: 'Pedidos', icon: '📦', tab: 'pedidos' },
  { href: '/admin/ajustes', label: 'Ajustes', icon: '⚙️', tab: 'ajustes' },
];

const links = isAdmin ? adminLinks : publicLinks;
---

<nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-solaris-border shadow-lg z-50">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex justify-around items-center h-16">
      {links.map((link) => (
        <a
          href={link.href}
          class={`flex flex-col items-center justify-center flex-1 h-full transition-colors ${
            activeTab === link.tab
              ? 'text-solaris-primary'
              : 'text-solaris-text hover:text-solaris-dark'
          }`}
        >
          <span class="text-2xl mb-1">{link.icon}</span>
          <span class="text-xs font-semibold">{link.label}</span>
        </a>
      ))}
    </div>
  </div>
</nav>
