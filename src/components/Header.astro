---
interface Props {
  activeTab?: string;
}
const { activeTab = 'inicio' } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 bg-white border-b border-gray-100 shadow-sm z-50">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    
    <!-- Logo SVG + SolarPower con colores -->
    <a href="/" class="flex items-center gap-2">
      <svg width="40" height="40" viewBox="0 0 120 120" class="drop-shadow-md">
        <circle cx="60" cy="35" r="22" fill="#f59e0b"/>
        <g stroke="#f59e0b" stroke-width="3" stroke-linecap="round">
          <line x1="60" y1="5" x2="60" y2="12"/>
          <line x1="30" y1="35" x2="37" y2="35"/>
          <line x1="83" y1="35" x2="90" y2="35"/>
          <line x1="39" y1="14" x2="44" y2="19"/>
          <line x1="76" y1="51" x2="81" y2="56"/>
          <line x1="39" y1="56" x2="44" y2="51"/>
          <line x1="76" y1="19" x2="81" y2="14"/>
        </g>
        <g transform="translate(60, 75) rotate(-15)">
          <rect x="-35" y="-20" width="70" height="40" rx="3" fill="#1e3a8a" stroke="#60a5fa" stroke-width="2"/>
          <line x1="-35" y1="-7" x2="35" y2="-7" stroke="#60a5fa" stroke-width="1.5"/>
          <line x1="-35" y1="7" x2="35" y2="7" stroke="#60a5fa" stroke-width="1.5"/>
          <line x1="-12" y1="-20" x2="-12" y2="20" stroke="#60a5fa" stroke-width="1.5"/>
          <line x1="12" y1="-20" x2="12" y2="20" stroke="#60a5fa" stroke-width="1.5"/>
          <rect x="-33" y="-18" width="66" height="12" rx="2" fill="white" opacity="0.2"/>
        </g>
        <rect x="55" y="95" width="10" height="15" rx="2" fill="#94a3b8"/>
        <rect x="45" y="108" width="30" height="4" rx="2" fill="#64748b"/>
      </svg>
      <span class="text-xl font-bold tracking-tight">
        <span class="text-gray-900">Solar</span><span class="text-yellow-500">Power</span>
      </span>
    </a>
    
    <!-- Botón Contactar con menú desplegable -->
    <div class="relative">
      <button id="btn-contactar" class="px-4 py-2 bg-solaris-accent text-white font-semibold rounded-lg hover:bg-yellow-600 transition-colors">
        Contactar
      </button>
      
      <div id="menu-contactar" class="hidden absolute top-full right-0 mt-2 bg-white border border-gray-200 shadow-2xl rounded-xl p-2 w-56 z-50">
        <a href="https://wa.me/5359135896" target="_blank" class="flex items-center gap-3 px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-green-50 rounded-lg">
          <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          </div>
          <span>WhatsApp</span>
        </a>
        <a href="tel:+5359135896" class="flex items-center gap-3 px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-blue-50 rounded-lg">
          <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <span>Llamar</span>
        </a>
        <a href="sms:+5359135896" class="flex items-center gap-3 px-4 py-3 text-sm font-semibold text-gray-700 hover:bg-orange-50 rounded-lg">
          <div class="w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
          </div>
          <span>SMS</span>
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    const btn = document.getElementById('btn-contactar');
    const menu = document.getElementById('menu-contactar');
    if (btn && menu) {
      btn.addEventListener('click', (e) => { e.stopPropagation(); menu.classList.toggle('hidden'); });
      document.addEventListener('click', (e) => {
        if (!btn.contains(e.target) && !menu.contains(e.target)) { menu.classList.add('hidden'); }
      });
    }
  </script>
</header>
