---
import { supabase } from '../lib/supabase.js';

const { data: settings } = await supabase.from('site_settings').select('*');
const settingsObj = {};
settings?.forEach(s => { settingsObj[s.key] = s.value; });

interface Props {
  activeTab?: string;
}
const { activeTab = 'inicio' } = Astro.props;
---

<header class="bg-white border-b border-solaris-border sticky top-0 z-40 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      {settingsObj.site_logo ? (
        <img src={settingsObj.site_logo} alt="Logo" class="h-10 w-auto object-contain" />
      ) : (
        <svg width="36" height="36" viewBox="0 0 40 40" fill="none">
          <rect x="8" y="12" width="24" height="20" rx="3" stroke="#0F172A" stroke-width="2.5" fill="none"/>
          <line x1="8" y1="18.66" x2="32" y2="18.66" stroke="#0F172A" stroke-width="1.5"/>
          <line x1="8" y1="25.33" x2="32" y2="25.33" stroke="#0F172A" stroke-width="1.5"/>
          <line x1="16" y1="12" x2="16" y2="32" stroke="#0F172A" stroke-width="1.5"/>
          <line x1="24" y1="12" x2="24" y2="32" stroke="#0F172A" stroke-width="1.5"/>
          <circle cx="20" cy="6" r="3" fill="#F59E0B"/>
        </svg>
      )}
      <span class="text-xl md:text-2xl font-bold text-solaris-dark">{settingsObj.site_name || 'SOLARIS'}</span>
    </a>
    
    <!-- Botón Contactar Expandible -->
    <div class="relative">
      <button id="contact-btn" class="bg-solaris-accent hover:bg-amber-600 text-white px-4 py-2 rounded-card font-semibold text-sm transition-all flex items-center gap-2">
        Contactar
        <svg id="contact-arrow" class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      
      <!-- Menú desplegable -->
      <div id="contact-menu" class="hidden absolute right-0 top-full mt-2 w-48 bg-white rounded-card shadow-lg border border-solaris-border overflow-hidden z-50">
        <a href={`https://wa.me/${settingsObj.whatsapp_number || '1234567890'}`} target="_blank" class="flex items-center gap-3 px-4 py-3 hover:bg-solaris-gray transition-colors border-b border-solaris-border">
          <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          <span class="text-sm font-medium text-solaris-dark">WhatsApp</span>
        </a>
        <a href={`tel:${settingsObj.phone || '+521234567890'}`} class="flex items-center gap-3 px-4 py-3 hover:bg-solaris-gray transition-colors border-b border-solaris-border">
          <svg class="w-5 h-5 text-solaris-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="text-sm font-medium text-solaris-dark">Llamar</span>
        </a>
        <a href={`sms:${settingsObj.phone || '+521234567890'}`} class="flex items-center gap-3 px-4 py-3 hover:bg-solaris-gray transition-colors">
          <svg class="w-5 h-5 text-solaris-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
          </svg>
          <span class="text-sm font-medium text-solaris-dark">SMS</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const contactBtn = document.getElementById('contact-btn');
  const contactMenu = document.getElementById('contact-menu');
  const contactArrow = document.getElementById('contact-arrow');
  
  contactBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    contactMenu.classList.toggle('hidden');
    contactArrow.style.transform = contactMenu.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
  });
  
  // Cerrar al hacer clic fuera
  document.addEventListener('click', (e) => {
    if (!contactBtn?.contains(e.target) && !contactMenu?.contains(e.target)) {
      contactMenu?.classList.add('hidden');
      contactArrow.style.transform = 'rotate(0deg)';
    }
  });
</script>
