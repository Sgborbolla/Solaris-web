---
// Componente Logo Solaris
// Isotipo lineal de panel solar con rayos + texto
---

<a href="/" class="flex items-center gap-2 group">
  <!-- Isotipo SVG -->
  <svg 
    width="40" 
    height="40" 
    viewBox="0 0 40 40" 
    fill="none" 
    xmlns="http://www.w3.org/2000/svg"
    class="transition-transform duration-300 group-hover:scale-105"
  >
    <!-- Rayos solares (Acento dorado) -->
    <path d="M20 4V8" stroke="#F59E0B" stroke-width="2" stroke-linecap="round"/>
    <path d="M28 6L26 9" stroke="#F59E0B" stroke-width="2" stroke-linecap="round"/>
    <path d="M12 6L14 9" stroke="#F59E0B" stroke-width="2" stroke-linecap="round"/>
    
    <!-- Panel solar rectangular (Azul oscuro) -->
    <rect x="8" y="12" width="24" height="20" rx="3" stroke="#0F172A" stroke-width="2.5" fill="none"/>
    
    <!-- Celdas fotovoltaicas (Líneas internas) -->
    <line x1="8" y1="18.66" x2="32" y2="18.66" stroke="#0F172A" stroke-width="1.5"/>
    <line x1="8" y1="25.33" x2="32" y2="25.33" stroke="#0F172A" stroke-width="1.5"/>
    <line x1="16" y1="12" x2="16" y2="32" stroke="#0F172A" stroke-width="1.5"/>
    <line x1="24" y1="12" x2="24" y2="32" stroke="#0F172A" stroke-width="1.5"/>
    
    <!-- Destello solar superior (Acento dorado) -->
    <circle cx="20" cy="6" r="1.5" fill="#F59E0B"/>
  </svg>
  
  <!-- Texto -->
  <span class="text-2xl font-bold text-solaris-dark tracking-tight">
    SOLARIS
  </span>
</a>