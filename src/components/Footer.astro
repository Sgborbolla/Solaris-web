---
import { getSocialLinks, getSocialIcon } from '../lib/social.js';
import { supabase } from '../lib/supabase.js';

const socialLinks = await getSocialLinks();
const { data: settings } = await supabase.from('site_settings').select('*');
const settingsObj = {};
settings?.forEach(s => { settingsObj[s.key] = s.value; });
---

<footer class="bg-solaris-dark text-white">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <div class="lg:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          {settingsObj.site_logo ? (
            <img src={settingsObj.site_logo} alt="Logo" class="h-10" />
          ) : (
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
              <rect x="8" y="12" width="24" height="20" rx="3" stroke="#F59E0B" stroke-width="2.5" fill="none"/>
              <line x1="8" y1="18.66" x2="32" y2="18.66" stroke="#F59E0B" stroke-width="1.5"/>
              <line x1="8" y1="25.33" x2="32" y2="25.33" stroke="#F59E0B" stroke-width="1.5"/>
              <line x1="16" y1="12" x2="16" y2="32" stroke="#F59E0B" stroke-width="1.5"/>
              <line x1="24" y1="12" x2="24" y2="32" stroke="#F59E0B" stroke-width="1.5"/>
              <circle cx="20" cy="6" r="3" fill="#F59E0B"/>
            </svg>
          )}
          <span class="text-2xl font-bold">{settingsObj.site_name || 'SOLARIS'}</span>
        </div>
        <p class="text-solaris-gray text-sm leading-relaxed mb-4">
          Transformando el futuro con energía limpia y sostenible.
        </p>
      </div>

      <div>
        <h3 class="text-lg font-semibold mb-4 text-solaris-accent">Enlaces Rápidos</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="text-solaris-gray hover:text-white transition-colors">Inicio</a></li>
          <li><a href="/productos" class="text-solaris-gray hover:text-white transition-colors">Productos</a></li>
          <li><a href="/proyectos" class="text-solaris-gray hover:text-white transition-colors">Proyectos</a></li>
          <li><a href="/nosotros" class="text-solaris-gray hover:text-white transition-colors">Nosotros</a></li>
          <li><a href="/faq" class="text-solaris-gray hover:text-white transition-colors">FAQ</a></li>
          <li><a href="/contacto" class="text-solaris-gray hover:text-white transition-colors">Contacto</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-semibold mb-4 text-solaris-accent">Productos</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/productos" class="text-solaris-gray hover:text-white transition-colors">Paneles Solares</a></li>
          <li><a href="/productos" class="text-solaris-gray hover:text-white transition-colors">Inversores</a></li>
          <li><a href="/productos" class="text-solaris-gray hover:text-white transition-colors">Baterías</a></li>
          <li><a href="/productos" class="text-solaris-gray hover:text-white transition-colors">Accesorios</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-semibold mb-4 text-solaris-accent">Contacto</h3>
        <ul class="space-y-3 text-sm text-solaris-gray">
          {settingsObj.phone && (
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-solaris-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <a href={`tel:${settingsObj.phone}`} class="hover:text-white transition-colors">{settingsObj.phone}</a>
            </li>
          )}
          {settingsObj.email && (
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-solaris-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <a href={`mailto:${settingsObj.email}`} class="hover:text-white transition-colors">{settingsObj.email}</a>
            </li>
          )}
          {settingsObj.address && (
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-solaris-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>{settingsObj.address}</span>
            </li>
          )}
        </ul>
      </div>
    </div>

    {socialLinks.length > 0 && (
      <div class="border-t border-solaris-gray/20 pt-8 mt-8">
        <h3 class="text-lg font-semibold mb-4 text-center text-solaris-accent">Síguenos</h3>
        <div class="flex justify-center gap-4">
          {socialLinks.map((social) => (
            <a 
              href={social.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-full bg-solaris-gray/10 flex items-center justify-center hover:bg-solaris-accent transition-all duration-300 hover:scale-110"
              title={social.name || social.platform}
              set:html={getSocialIcon(social.platform)}
            />
          ))}
        </div>
      </div>
    )}
  </div>

  <div class="border-t border-solaris-gray/20 py-6">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <p class="text-sm text-solaris-gray">
        Creado y Diseñado por QBASwing Designer 2026. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
