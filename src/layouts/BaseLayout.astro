---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Soluciones de energía solar profesionales" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F172A" />
    <title>{title} | Solaris</title>
  </head>
  <body class="bg-solaris-light text-solaris-dark font-sans antialiased min-h-screen flex flex-col">
    <slot />
  </body>
</html>